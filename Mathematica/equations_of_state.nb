                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
                 RowBox[{"assocDef", "[", "name", "]"}]}]}], ",", 
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{
                  "\"\<    \>\"", "<>", "name", "<>", "\"\<(idx) = \>\"", "<>", 
                   RowBox[{"assocAlt", "[", "name", "]"}], "<>", 
                   "\"\<;\\n\>\""}]}], "]"}], ";"}]}], "]"}]}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "first7", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", "\"\<    dbetapardB0 = dbetapardB(1,1);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<    if nargout > 7 % Jacobian computation\\n\>\""}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "remaining", " ", "derivatives"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"name", "=", 
           RowBox[{"outList", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"name", "=!=", "\"\<dbetapardB0\>\""}], "&&", 
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"first7", ",", "name"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"WriteString", "[", 
              RowBox[{"stream", ",", 
               RowBox[{
               "\"\<        \>\"", "<>", "name", "<>", "\"\< = \>\"", "<>", 
                RowBox[{"assocDef", "[", "name", "]"}], "<>", 
                "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"isPW", "&&", 
                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
                 "\"\<\>\""}], "&&", 
                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
                 RowBox[{"assocDef", "[", "name", "]"}]}]}], ",", 
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{
                  "\"\<        \>\"", "<>", "name", "<>", "\"\<(idx) = \>\"", 
                   "<>", 
                   RowBox[{"assocAlt", "[", "name", "]"}], "<>", 
                   "\"\<;\\n\>\""}]}], "]"}], ";"}]}], "]"}]}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "8", ",", 
           RowBox[{
            RowBox[{"Length", "[", "outList", "]"}], "-", "2"}]}], "}"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<        if nargout > 14 % postprocessing\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "betapar", " ", "and", " ", "betaperp"}], 
        "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{"isPW", ",", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betapar = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", "bp1", "]"}], "<>", "\"\<;\\n\>\""}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betapar(idx) = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"bp2", ",", "True"}], "]"}], "<>", "\"\<;\\n\>\""}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Compute", " ", "derivative", " ", "for", " ", "betaperp"}], 
           "*)"}], 
          RowBox[{"d1", "=", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", 
                RowBox[{"0", ",", "1", ",", "0"}], "]"}], "[", "betapar", 
               "]"}], "[", 
              RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "/.", " ", 
             RowBox[{
              RowBox[{"betapar", "[", 
               RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "->", "bp1"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"d2", "=", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", 
                RowBox[{"0", ",", "1", ",", "0"}], "]"}], "[", "betapar", 
               "]"}], "[", 
              RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "/.", " ", 
             RowBox[{
              RowBox[{"betapar", "[", 
               RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "->", "bp2"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betaperp = betapar - BB.*(\>\"", "<>", 
             RowBox[{"ToMatlab", "[", "d1", "]"}], "<>", "\"\<);\\n\>\""}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{
            "\"\<            betaperp(idx) = betapar(idx) - BB(idx).*(\>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"d2", ",", "True"}], "]"}], "<>", "\"\<);\\n\>\""}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betapar   = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"Simplify", "[", 
               RowBox[{"betapar", "[", 
                RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "]"}], "]"}], 
             "<>", "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betaperp  = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"Simplify", "[", 
               RowBox[{
                RowBox[{"betapar", "[", 
                 RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "-", 
                RowBox[{"BB", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Derivative", "[", 
                    RowBox[{"0", ",", "1", ",", "0"}], "]"}], "[", "betapar", 
                   "]"}], "[", 
                  RowBox[{"r", ",", "BB", ",", "RR"}], "]"}]}]}], "]"}], 
              "]"}], "<>", "\"\<;\\n\>\""}]}], "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<        end\\n    end\\nend\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Close", "[", "stream", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Wrote MATLAB file \\\"\>\"", ",", "fileName", ",", 
         "\"\<\\\" with <\>\"", ",", "funcName", ",", "\"\<>.\>\""}], "]"}], 
       ";"}]}], "]"}]}], "\n"}]}]], "Input",
