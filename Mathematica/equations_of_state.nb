                "\[IndentingNewLine]", 
                RowBox[{"s2", "=", 
                 RowBox[{"ToMatlab", "[", 
                  RowBox[{
                   RowBox[{"Simplify", "[", "d2", "]"}], ",", "True"}], 
                  "]"}]}], ";"}], " ", 
               RowBox[{"(*", 
