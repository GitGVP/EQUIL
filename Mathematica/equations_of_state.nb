       RowBox[{
        RowBox[{"Head", "[", "processed", "]"}], "===", "List"}], ",", 
       RowBox[{
        RowBox[{"processed", "=", 
         RowBox[{"First", "[", "processed", "]"}]}], ";"}]}], " ", 
      RowBox[{"(*", 
