        RowBox[{"isPW", ",", 
         RowBox[{"bp2", "=", 
          RowBox[{"Simplify", "[", "bp2", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"results", "=", 
