                "\[IndentingNewLine]", 
                RowBox[{"s2", "=", "\"\<\>\""}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"s1", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"StringTrim", "[", "s1", "]"}], "===", "\"\<\>\""}],
                  "||", 
                 RowBox[{
                  RowBox[{"StringTrim", "[", "s1", "]"}], "===", 
                  "\"\<0\>\""}]}], ",", "\"\<zeros(size(RR))\>\"", ",", 
