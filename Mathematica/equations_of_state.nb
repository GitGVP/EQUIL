            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"chars", ">", "maxLen"}], ",", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"parts", ",", 
                 RowBox[{
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{
                    RowBox[{"Most", "[", "current", "]"}], ",", 
                    "\"\<, \>\""}], "]"}], "<>", "\"\<, ...\\n    \>\"", "<>", 
                  RowBox[{"Last", "[", "current", "]"}]}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"current", "=", 
                RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"chars", "=", 
                RowBox[{"4", "+", 
                 RowBox[{"StringLength", "[", "#", "]"}]}]}], ";"}]}], 
             "]"}]}], ")"}], "&"}], ",", "outList"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"current", "=!=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"parts", ",", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"current", ",", "\"\<, \>\""}], "]"}]}], "]"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"headerLine", "=", 
        RowBox[{"\"\<function [\>\"", "<>", 
         RowBox[{"StringRiffle", "[", 
          RowBox[{"parts", ",", "\"\<, \>\""}], "]"}], "<>", "\"\<] = \>\"", "<>",
          "funcName", "<>", "\"\<(kinetic_profiles,r,RR,BB)\\n\>\""}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "headerLine"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "kinetic", " ", "profiles"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "presentProfiles", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"isPW", ",", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
