      "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"StringTrim", "[", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{
          RowBox[{"RegularExpression", "[", "\"\<\\\\s+\>\"", "]"}], "->", 
          "\"\< \>\""}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "trigonometric", " ", "functions", " ", "and", " ", "vectorized", " ", 
       "operations"}], "*)"}], 
     RowBox[{"str", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<Cos\>\"", "->", "\"\<cos\>\""}], ",", 
          RowBox[{"\"\<Sin\>\"", "->", "\"\<sin\>\""}], ",", 
