     RowBox[{"(*", "Conditionals", "*)"}], 
     RowBox[{"str", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<\\\\b.ge.\\\\b\>\"", "]"}], 
           "->", "\"\< >= \>\""}], ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<\\\\b.lt.\\\\b\>\"", "]"}], 
           "->", "\"\< < \>\""}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Apply", " ", "indexing", " ", "if", " ", "requested"}], "*)"}], 
     RowBox[{"If", "[", 
      RowBox[{"indexed", ",", 
