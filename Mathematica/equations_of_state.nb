               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"For", " ", "non"}], "-", 
                 RowBox[{"Piecewise", ":", 
                  RowBox[{"standard", " ", "computation"}]}]}], "*)"}], 
               RowBox[{
                RowBox[{"d", "=", 
