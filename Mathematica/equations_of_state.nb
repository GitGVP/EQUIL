                    RowBox[{"betapar", "[", 
                    RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "->", 
                    "bp1"}]}], ",", "0"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
