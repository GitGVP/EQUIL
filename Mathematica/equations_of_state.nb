Cell[BoxData[{
 RowBox[{
  RowBox[{"kinprofiles", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<beta\>\"", ",", " ", "\"\<Ah\>\"", ",", " ", "\"\<mach2\>\""}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"presentProfiles", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"kinprofiles", ",", " ", 
     RowBox[{
      RowBox[{"StringContainsQ", "[", 
       RowBox[{
        RowBox[{"ToMatlab", "[", 
         RowBox[{"betapar", "[", 
          RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "]"}], ",", "#"}], 
       "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WriteMatlab", "[", 
   RowBox[{"fileName_String", ",", "funcName_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "stream", ",", "outList", ",", "first7", ",", "derivSpecs", ",", 
      "results", ",", "assoc", ",", "headerLine", ",", "i", ",", "d", ",", 
      "s", ",", "name"}], "}"}], ",", 
    RowBox[{
     RowBox[{"outList", "=", 
      RowBox[{"{", 
       RowBox[{
       "\"\<dbetapardB0\>\"", ",", "\"\<dbetapardr\>\"", ",", 
        "\"\<dbetapardB\>\"", ",", "\"\<dbetapardR\>\"", ",", 
        "\"\<d2betapardB2\>\"", ",", "\"\<d2betapardrdB\>\"", ",", 
        "\"\<d2betapardRdB\>\"", ",", "\"\<d2betapardrdR\>\"", ",", 
        "\"\<d2betapardR2\>\"", ",", "\"\<d3betapardrdB2\>\"", ",", 
        "\"\<d3betapardB3\>\"", ",", "\"\<d3betapardBdR2\>\"", ",", 
        "\"\<d3betapardB2dR\>\"", ",", "\"\<d3betapardrdRdB\>\""}], "}"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"first7", "=", 
      RowBox[{"outList", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "7"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"derivSpecs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
          "\"\<dbetapardr\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
          "\"\<dbetapardB\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
          "\"\<dbetapardR\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "2", ",", "0"}], "}"}], ",", 
          "\"\<d2betapardB2\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
          "\"\<d2betapardrdB\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
          "\"\<d2betapardRdB\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
          "\"\<d2betapardrdR\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
          "\"\<d2betapardR2\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
          "\"\<d3betapardrdB2\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "3", ",", "0"}], "}"}], ",", 
          "\"\<d3betapardB3\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2"}], "}"}], ",", 
          "\"\<d3betapardBdR2\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "2", ",", "1"}], "}"}], ",", 
          "\"\<d3betapardB2dR\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
          "\"\<d3betapardrdRdB\>\""}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "=", 
             RowBox[{"derivSpecs", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1", ",", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{"b", "=", 
             RowBox[{"derivSpecs", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{"c", "=", 
             RowBox[{"derivSpecs", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1", ",", "3"}], "]"}], "]"}]}], ",", 
            RowBox[{"nm", "=", 
             RowBox[{"derivSpecs", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
          RowBox[{
           RowBox[{"d", "=", 
            RowBox[{"Quiet", "[", 
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Derivative", "[", 
                  RowBox[{"a", ",", "b", ",", "c"}], "]"}], "[", "betapar", 
                 "]"}], "[", 
                RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], ",", "0"}], "]"}],
              "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"s", "=", 
            RowBox[{"ToMatlab", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"s", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"StringTrim", "[", "s", "]"}], "===", "\"\<\>\""}], "||", 
               RowBox[{
                RowBox[{"StringTrim", "[", "s", "]"}], "===", "\"\<0\>\""}]}],
               ",", "\"\<zeros(size(RR))\>\"", ",", "s"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"nm", ",", "s"}], "}"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "derivSpecs", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"assoc", "=", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"results", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "->", 
        RowBox[{"results", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"stream", "=", 
      RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxLen", "=", "80"}], ";", "\n", 
     RowBox[{"line", "=", "\"\<function [\>\""}], ";", "\n", 
     RowBox[{"chars", "=", 
      RowBox[{"StringLength", "[", "line", "]"}]}], ";", "\n", 
     RowBox[{"parts", "=", 
      RowBox[{"{", "}"}]}], ";", "\n", 
     RowBox[{"current", "=", 
      RowBox[{"{", "}"}]}], ";", "\n", 
     RowBox[{"Scan", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"current", ",", "#"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"chars", "+=", 
           RowBox[{
            RowBox[{"StringLength", "[", "#", "]"}], "+", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"current", "===", 
               RowBox[{"{", "}"}]}], ",", "0", ",", "2"}], "]"}]}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"comma", "+", "space"}], "*)"}], 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"chars", ">", "maxLen"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"parts", ",", 
               RowBox[{
                RowBox[{"StringRiffle", "[", 
                 RowBox[{
                  RowBox[{"Most", "[", "current", "]"}], ",", "\"\<, \>\""}], 
                 "]"}], "<>", "\"\<, ...\\n    \>\"", "<>", 
                RowBox[{"Last", "[", "current", "]"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"current", "=", 
              RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"chars", "=", 
              RowBox[{"4", "+", 
               RowBox[{"StringLength", "[", "#", "]"}]}]}], ";"}]}], " ", 
           RowBox[{"(*", "indentation", "*)"}], "]"}]}], ")"}], "&"}], ",", 
       "outList"}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"current", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"parts", ",", 
         RowBox[{"StringRiffle", "[", 
          RowBox[{"current", ",", "\"\<, \>\""}], "]"}]}], "]"}]}], "]"}], 
     ";", "\n", 
     RowBox[{"headerLine", "=", 
      RowBox[{"\"\<function [\>\"", "<>", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{"parts", ",", "\"\<, \>\""}], "]"}], "<>", "\"\<] = \>\"", "<>",
        "funcName", "<>", "\"\<(kinetic_profiles,r,RR,BB)\\n\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"WriteString", "[", 
      RowBox[{"stream", ",", "headerLine"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"WriteString", "[", 
         RowBox[{"stream", ",", 
          RowBox[{"\"\<    \>\"", " ", "<>", " ", 
           RowBox[{"presentProfiles", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "<>", " ", 
           "\"\< = kinetic_profiles.\>\"", " ", "<>", " ", 
           RowBox[{"presentProfiles", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "<>", "\"\<(r);\\n\>\""}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"WriteString", "[", 
         RowBox[{"stream", ",", 
          RowBox[{"\"\<    \>\"", " ", "<>", " ", 
           RowBox[{"presentProfiles", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "<>", " ", 
           "\"\<p = kinetic_profiles.\>\"", " ", "<>", " ", 
           RowBox[{"presentProfiles", "[", 
