          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "derivSpecs", "]"}]}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"assocDef", "=", 
