                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\< = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<(r) * ones(1,size(RR,2));\\n\>\""}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p(r) * ones(1,size(RR,2));\\n\>\""}]}], "]"}], ";"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "presentProfiles", "]"}]}], "}"}]}], 
              "]"}], ";"}], ",", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\< = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<(r);\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p(r);\\n\>\""}]}], "]"}], ";"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "presentProfiles", "]"}]}], "}"}]}], 
              "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Write", " ", "condition", " ", "for", " ", "Piecewise", " ", 
         "case"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"isPW", ",", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{
            "\"\<    idx = \>\"", "<>", "condStr", "<>", "\"\<;\\n\>\""}]}], 
           "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "first", " ", "7", " ", "derivatives"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"name", "=", 
           RowBox[{"first7", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"name", "=!=", "\"\<dbetapardB0\>\""}], ",", 
            RowBox[{
             RowBox[{"WriteString", "[", 
              RowBox[{"stream", ",", 
               RowBox[{"\"\<    \>\"", "<>", "name", "<>", "\"\< = \>\"", "<>", 
                RowBox[{"assocDef", "[", "name", "]"}], "<>", 
                "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"isPW", "&&", 
                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
