 RowBox[{
  RowBox[{"ToMatlab", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "str", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"str", "=", 
      RowBox[{"ToString", "[", 
       RowBox[{
        RowBox[{"expr", "/.", " ", "numrepl"}], ",", "FortranForm"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<\\n\>\"", "->", "\"\< \>\""}], ",", 
          RowBox[{"\"\<\\r\>\"", "->", "\"\< \>\""}], ",", 
          RowBox[{"\"\<\\t\>\"", "->", "\"\< \>\""}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"StringTrim", "[", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{
          RowBox[{"RegularExpression", "[", "\"\<\\\\s+\>\"", "]"}], "->", 
          "\"\< \>\""}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "trigonometric", " ", "functions", " ", "and", " ", "vectorized", " ", 
       "operations"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<Cos\>\"", "->", "\"\<cos\>\""}], ",", 
          RowBox[{"\"\<Sin\>\"", "->", "\"\<sin\>\""}], ",", 
          RowBox[{"\"\<Csc\>\"", "->", "\"\<csc\>\""}], ",", 
          RowBox[{"\"\<**\>\"", "->", "\"\<.^\>\""}], ",", 
          RowBox[{"\"\<*\>\"", "->", "\"\<.*\>\""}], ",", 
          RowBox[{"\"\</\>\"", "->", "\"\<./\>\""}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "exponentials", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"str", " ", "=", " ", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
           "RegularExpression", "[", "\"\<\\\\bE\\\\.\\\\^\\\\(\>\"", "]"}], 
           "->", "\"\<exp(\>\""}], ",", 
          RowBox[{
           RowBox[{
           "RegularExpression", "[", "\"\<\\\\bE\\\\^\\\\(\>\"", "]"}], "->", 
