            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"assocAlt", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"results", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "->", 
          RowBox[{"results", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"stream", "=", 
        RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxLen", "=", "80"}], ";", "\[IndentingNewLine]", 
       RowBox[{"line", "=", "\"\<function [\>\""}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"chars", "=", 
        RowBox[{"StringLength", "[", "line", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"parts", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"current", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Scan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"current", ",", "#"}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"chars", "+=", 
             RowBox[{
              RowBox[{"StringLength", "[", "#", "]"}], "+", 
