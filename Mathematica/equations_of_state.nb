Cell[BoxData[{
 RowBox[{
  RowBox[{"kinprofiles", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<beta\>\"", ",", " ", "\"\<Ah\>\"", ",", " ", "\"\<mach2\>\"", ",", 
     "\"\<Bc\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"presentProfiles", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"kinprofiles", ",", " ", 
     RowBox[{
      RowBox[{"StringContainsQ", "[", 
       RowBox[{
        RowBox[{"ToMatlab", "[", 
         RowBox[{"betapar", "[", 
          RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "]"}], ",", "#"}], 
       "]"}], "&"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"236ed388-32d1-4630-8651-664f0a6fcf6f"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"WriteMatlab", "[", 
     RowBox[{"fileName_String", ",", "funcName_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "stream", ",", "outList", ",", "first7", ",", "derivSpecs", ",", "bp", 
        ",", "isPW", ",", "bp1", ",", "bp2", ",", "condStr", ",", "results", 
        ",", "assocDef", ",", "assocAlt", ",", "headerLine", ",", "i", ",", 
        "d", ",", "s1", ",", "s2", ",", "name", ",", "maxLen", ",", "parts", 
        ",", "current", ",", "chars"}], "}"}], ",", 
      RowBox[{
       RowBox[{"outList", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<dbetapardB0\>\"", ",", "\"\<dbetapardr\>\"", ",", 
          "\"\<dbetapardB\>\"", ",", "\"\<dbetapardR\>\"", ",", 
          "\"\<d2betapardB2\>\"", ",", "\"\<d2betapardrdB\>\"", ",", 
          "\"\<d2betapardRdB\>\"", ",", "\"\<d2betapardrdR\>\"", ",", 
          "\"\<d2betapardR2\>\"", ",", "\"\<d3betapardrdB2\>\"", ",", 
          "\"\<d3betapardB3\>\"", ",", "\"\<d3betapardBdR2\>\"", ",", 
          "\"\<d3betapardB2dR\>\"", ",", "\"\<d3betapardrdRdB\>\"", ",", 
          "\"\<betapar\>\"", ",", "\"\<betaperp\>\""}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"first7", "=", 
        RowBox[{"outList", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "7"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"derivSpecs", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
            "\"\<dbetapardr\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
            "\"\<dbetapardB\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
            "\"\<dbetapardR\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "2", ",", "0"}], "}"}], ",", 
            "\"\<d2betapardB2\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
            "\"\<d2betapardrdB\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
            "\"\<d2betapardRdB\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
            "\"\<d2betapardrdR\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
            "\"\<d2betapardR2\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
            "\"\<d3betapardrdB2\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "3", ",", "0"}], "}"}], ",", 
            "\"\<d3betapardB3\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "2"}], "}"}], ",", 
            "\"\<d3betapardBdR2\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "2", ",", "1"}], "}"}], ",", 
            "\"\<d3betapardB2dR\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
            "\"\<d3betapardrdRdB\>\""}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Extract", " ", "base", " ", "function", " ", "and", " ", "handle", 
         " ", "Piecewise"}], "*)"}], 
       RowBox[{"bp", "=", 
        RowBox[{"betapar", "[", 
         RowBox[{"r", ",", "BB", ",", "RR"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"isPW", "=", 
        RowBox[{
         RowBox[{"Head", "[", "bp", "]"}], "===", "Piecewise"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"isPW", ",", 
         RowBox[{
          RowBox[{"bp1", "=", 
           RowBox[{"bp", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"First", " ", "branch", " ", "expression"}], "*)"}], 
          RowBox[{"bp2", "=", 
           RowBox[{"bp", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2", ",", "1"}], "]"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"Second", " ", "branch", " ", "expression"}], "*)"}], 
          RowBox[{"condStr", "=", 
           RowBox[{"ToMatlab", "[", 
            RowBox[{"bp", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}],
          "  ", 
         RowBox[{"(*", "Condition", "*)"}], ",", 
         RowBox[{
          RowBox[{"bp1", "=", "bp"}], ";", "\[IndentingNewLine]", 
          RowBox[{"bp2", "=."}], ";", "\[IndentingNewLine]", 
          RowBox[{"condStr", "=."}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Pre", "-", 
         RowBox[{"simplify", " ", "once"}]}], "*)"}], 
       RowBox[{"bp1", "=", 
        RowBox[{"Simplify", "[", "bp1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"isPW", ",", 
         RowBox[{"bp2", "=", 
          RowBox[{"Simplify", "[", "bp2", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"results", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "=", 
               RowBox[{"derivSpecs", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1", ",", "1"}], "]"}], "]"}]}], ",", 
              RowBox[{"b", "=", 
               RowBox[{"derivSpecs", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1", ",", "2"}], "]"}], "]"}]}], ",", 
              RowBox[{"c", "=", 
               RowBox[{"derivSpecs", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1", ",", "3"}], "]"}], "]"}]}], ",", 
              RowBox[{"nm", "=", 
               RowBox[{"derivSpecs", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", "d", ",", "d1",
               ",", "d2"}], "}"}], ",", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{"isPW", ",", 
               RowBox[{"(*", 
                RowBox[{"For", " ", 
                 RowBox[{"Piecewise", ":", 
                  RowBox[{
                  "compute", " ", "derivatives", " ", "for", " ", "both", " ",
                    "branches"}]}]}], "*)"}], 
               RowBox[{
                RowBox[{"d1", "=", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Derivative", "[", 
                    RowBox[{"a", ",", "b", ",", "c"}], "]"}], "[", "betapar", 
                    "]"}], "[", 
                    RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "/.", " ", 
                    RowBox[{
                    RowBox[{"betapar", "[", 
                    RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "->", 
                    "bp1"}]}], ",", "0"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"d2", "=", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Derivative", "[", 
                    RowBox[{"a", ",", "b", ",", "c"}], "]"}], "[", "betapar", 
                    "]"}], "[", 
                    RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "/.", " ", 
                    RowBox[{
                    RowBox[{"betapar", "[", 
                    RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "->", 
                    "bp2"}]}], ",", "0"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"s1", "=", 
                 RowBox[{"ToMatlab", "[", 
                  RowBox[{"Simplify", "[", "d1", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"s2", "=", 
                 RowBox[{"ToMatlab", "[", 
                  RowBox[{
                   RowBox[{"Simplify", "[", "d2", "]"}], ",", "True"}], 
                  "]"}]}], ";"}], " ", 
               RowBox[{"(*", 
                RowBox[{
                "Use", " ", "indexing", " ", "for", " ", "second", " ", 
                 "branch"}], "*)"}], ",", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"For", " ", "non"}], "-", 
                 RowBox[{"Piecewise", ":", 
                  RowBox[{"standard", " ", "computation"}]}]}], "*)"}], 
               RowBox[{
                RowBox[{"d", "=", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Derivative", "[", 
                    RowBox[{"a", ",", "b", ",", "c"}], "]"}], "[", "betapar", 
                    "]"}], "[", 
                    RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], ",", "0"}], 
                   "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"s1", "=", 
                 RowBox[{"ToMatlab", "[", 
                  RowBox[{"Simplify", "[", "d", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"s2", "=", "\"\<\>\""}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"s1", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"StringTrim", "[", "s1", "]"}], "===", "\"\<\>\""}],
                  "||", 
                 RowBox[{
                  RowBox[{"StringTrim", "[", "s1", "]"}], "===", 
                  "\"\<0\>\""}]}], ",", "\"\<zeros(size(RR))\>\"", ",", 
                "s1"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"s2", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"StringTrim", "[", "s2", "]"}], "===", "\"\<\>\""}],
                  "||", 
                 RowBox[{
                  RowBox[{"StringTrim", "[", "s2", "]"}], "===", 
                  "\"\<0\>\""}]}], ",", "\"\<zeros(size(RR))\>\"", ",", 
                "s2"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"nm", ",", "s1", ",", "s2"}], "}"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "derivSpecs", "]"}]}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"assocDef", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"results", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "->", 
          RowBox[{"results", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"assocAlt", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"results", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "->", 
          RowBox[{"results", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"stream", "=", 
        RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxLen", "=", "80"}], ";", "\[IndentingNewLine]", 
       RowBox[{"line", "=", "\"\<function [\>\""}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"chars", "=", 
        RowBox[{"StringLength", "[", "line", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"parts", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"current", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Scan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"current", ",", "#"}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"chars", "+=", 
             RowBox[{
              RowBox[{"StringLength", "[", "#", "]"}], "+", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"current", "===", 
                 RowBox[{"{", "}"}]}], ",", "0", ",", "2"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"chars", ">", "maxLen"}], ",", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"parts", ",", 
                 RowBox[{
                  RowBox[{"StringRiffle", "[", 
                   RowBox[{
                    RowBox[{"Most", "[", "current", "]"}], ",", 
                    "\"\<, \>\""}], "]"}], "<>", "\"\<, ...\\n    \>\"", "<>", 
                  RowBox[{"Last", "[", "current", "]"}]}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"current", "=", 
                RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"chars", "=", 
                RowBox[{"4", "+", 
                 RowBox[{"StringLength", "[", "#", "]"}]}]}], ";"}]}], 
             "]"}]}], ")"}], "&"}], ",", "outList"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"current", "=!=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"parts", ",", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"current", ",", "\"\<, \>\""}], "]"}]}], "]"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"headerLine", "=", 
        RowBox[{"\"\<function [\>\"", "<>", 
         RowBox[{"StringRiffle", "[", 
          RowBox[{"parts", ",", "\"\<, \>\""}], "]"}], "<>", "\"\<] = \>\"", "<>",
          "funcName", "<>", "\"\<(kinetic_profiles,r,RR,BB)\\n\>\""}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "headerLine"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "kinetic", " ", "profiles"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "presentProfiles", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"isPW", ",", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\< = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<(r) * ones(1,size(RR,2));\\n\>\""}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p(r) * ones(1,size(RR,2));\\n\>\""}]}], "]"}], ";"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "presentProfiles", "]"}]}], "}"}]}], 
              "]"}], ";"}], ",", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\< = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<(r);\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{"\"\<    \>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p = kinetic_profiles.\>\"", "<>", 
                   RowBox[{"presentProfiles", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                   "\"\<p(r);\\n\>\""}]}], "]"}], ";"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "presentProfiles", "]"}]}], "}"}]}], 
              "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Write", " ", "condition", " ", "for", " ", "Piecewise", " ", 
         "case"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"isPW", ",", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{
            "\"\<    idx = \>\"", "<>", "condStr", "<>", "\"\<;\\n\>\""}]}], 
           "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "first", " ", "7", " ", "derivatives"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"name", "=", 
           RowBox[{"first7", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"name", "=!=", "\"\<dbetapardB0\>\""}], ",", 
            RowBox[{
             RowBox[{"WriteString", "[", 
              RowBox[{"stream", ",", 
               RowBox[{"\"\<    \>\"", "<>", "name", "<>", "\"\< = \>\"", "<>", 
                RowBox[{"assocDef", "[", "name", "]"}], "<>", 
                "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"isPW", "&&", 
                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
                 "\"\<\>\""}], "&&", 
                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
                 RowBox[{"assocDef", "[", "name", "]"}]}]}], ",", 
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{
                  "\"\<    \>\"", "<>", "name", "<>", "\"\<(idx) = \>\"", "<>", 
                   RowBox[{"assocAlt", "[", "name", "]"}], "<>", 
                   "\"\<;\\n\>\""}]}], "]"}], ";"}]}], "]"}]}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "first7", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", "\"\<    dbetapardB0 = dbetapardB(1,1);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<    if nargout > 7 % Jacobian computation\\n\>\""}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "remaining", " ", "derivatives"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"name", "=", 
           RowBox[{"outList", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"name", "=!=", "\"\<dbetapardB0\>\""}], "&&", 
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"first7", ",", "name"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"WriteString", "[", 
              RowBox[{"stream", ",", 
               RowBox[{
               "\"\<        \>\"", "<>", "name", "<>", "\"\< = \>\"", "<>", 
                RowBox[{"assocDef", "[", "name", "]"}], "<>", 
                "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"isPW", "&&", 
                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
                 "\"\<\>\""}], "&&", 
                RowBox[{
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"assocAlt", "[", "name", "]"}], "]"}], "=!=", 
                 RowBox[{"assocDef", "[", "name", "]"}]}]}], ",", 
               RowBox[{
                RowBox[{"WriteString", "[", 
                 RowBox[{"stream", ",", 
                  RowBox[{
                  "\"\<        \>\"", "<>", "name", "<>", "\"\<(idx) = \>\"", 
                   "<>", 
                   RowBox[{"assocAlt", "[", "name", "]"}], "<>", 
                   "\"\<;\\n\>\""}]}], "]"}], ";"}]}], "]"}]}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "8", ",", 
           RowBox[{
            RowBox[{"Length", "[", "outList", "]"}], "-", "2"}]}], "}"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<        if nargout > 13 % postprocessing\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Write", " ", "betapar", " ", "and", " ", "betaperp"}], 
        "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{"isPW", ",", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betapar = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", "bp1", "]"}], "<>", "\"\<;\\n\>\""}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betapar(idx) = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"bp2", ",", "True"}], "]"}], "<>", "\"\<;\\n\>\""}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Compute", " ", "derivative", " ", "for", " ", "betaperp"}], 
           "*)"}], 
          RowBox[{"d1", "=", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", 
                RowBox[{"0", ",", "1", ",", "0"}], "]"}], "[", "betapar", 
               "]"}], "[", 
              RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "/.", " ", 
             RowBox[{
              RowBox[{"betapar", "[", 
               RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "->", "bp1"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"d2", "=", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", 
                RowBox[{"0", ",", "1", ",", "0"}], "]"}], "[", "betapar", 
               "]"}], "[", 
              RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "/.", " ", 
             RowBox[{
              RowBox[{"betapar", "[", 
               RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "->", "bp2"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betaperp = betapar - BB.*(\>\"", "<>", 
             RowBox[{"ToMatlab", "[", "d1", "]"}], "<>", "\"\<);\\n\>\""}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{
            "\"\<            betaperp(idx) = betapar(idx) - BB(idx).*(\>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"d2", ",", "True"}], "]"}], "<>", "\"\<);\\n\>\""}]}], 
           "]"}], ";"}], ",", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betapar   = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"Simplify", "[", 
               RowBox[{"betapar", "[", 
                RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "]"}], "]"}], 
             "<>", "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<            betaperp  = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"Simplify", "[", 
               RowBox[{
                RowBox[{"betapar", "[", 
                 RowBox[{"r", ",", "BB", ",", "RR"}], "]"}], "-", 
                RowBox[{"BB", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Derivative", "[", 
                    RowBox[{"0", ",", "1", ",", "0"}], "]"}], "[", "betapar", 
                   "]"}], "[", 
                  RowBox[{"r", ",", "BB", ",", "RR"}], "]"}]}]}], "]"}], 
              "]"}], "<>", "\"\<;\\n\>\""}]}], "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<        end\\n    end\\nend\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Close", "[", "stream", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Wrote MATLAB file \\\"\>\"", ",", "fileName", ",", 
         "\"\<\\\" with <\>\"", ",", "funcName", ",", "\"\<>.\>\""}], "]"}], 
       ";"}]}], "]"}]}], "\n"}]}]], "Input",
