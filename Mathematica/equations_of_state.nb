     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "exponentials", "*)"}], 
     RowBox[{"str", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
           "RegularExpression", "[", "\"\<\\\\bE\\\\.\\\\^\\\\(\>\"", "]"}], 
           "->", "\"\<exp(\>\""}], ",", 
          RowBox[{
           RowBox[{
           "RegularExpression", "[", "\"\<\\\\bE\\\\^\\\\(\>\"", "]"}], "->", 
