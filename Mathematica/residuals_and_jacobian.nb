             ";"}]}], "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tend\\n\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", "\n", 
