    RowBox[{"\[Lambda]", "[", "i_", "]"}], ",", 
    RowBox[{"\[Lambda]", "[", "j_", "]"}], ",", 
    RowBox[{"NonConstants", "->", 
     RowBox[{"{", "\[Lambda]", "}"}]}]}], "]"}], ":=", 
  RowBox[{"KroneckerDelta", "[", 
   RowBox[{"i", ",", "j"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"mb", "/:", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"\[Alpha]_", ",", "mb"}], "]"}], " ", "rest___"}], ",", "mb"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"Times", "[", "rest", "]"}], "/.", " ", 
   RowBox[{"mb", ":>", "\[Alpha]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JB", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"resForJ", "/.", 
       RowBox[{
        RowBox[{"B", "[", 
         RowBox[{"r", ",", "mb"}], "]"}], "->", 
        RowBox[{"\[Lambda]", "[", "mb", "]"}]}]}], ",", 
      RowBox[{"\[Lambda]", "[", "lp", "]"}], ",", 
      RowBox[{"NonConstants", "->", 
       RowBox[{"{", "\[Lambda]", "}"}]}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "mb", "]"}], "->", 
     RowBox[{"B", "[", 
      RowBox[{"r", ",", "mb"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JBp", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"resForJ", "/.", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"1", ",", "0"}], "]"}], "[", "B", "]"}], "[", 
         RowBox[{"r", ",", "mb"}], "]"}], "->", 
        RowBox[{"\[Lambda]", "[", "mb", "]"}]}]}], ",", 
      RowBox[{"\[Lambda]", "[", "lp", "]"}], ",", 
      RowBox[{"NonConstants", "->", 
       RowBox[{"{", "\[Lambda]", "}"}]}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "mb", "]"}], "->", 
     RowBox[{
      RowBox[{
