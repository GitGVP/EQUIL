Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ToMatlab", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "str", ",", "replaceSum", ",", "posList", ",", "p", ",", "slen", ",", 
       "idx", ",", "commaPosList", ",", "args", ",", "inner", ",", "new", ",",
        "kdPairs", ",", "kk", ",", "depth", ",", "prev", ",", "j", ",", 
       "seg"}], "}"}], ",", 
     RowBox[{
      RowBox[{"str", "=", 
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"expr", "/.", " ", "numrepl"}], ",", "FortranForm"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<\\n\>\"", "->", "\"\< \>\""}], ",", 
           RowBox[{"\"\<\\r\>\"", "->", "\"\< \>\""}], ",", 
           RowBox[{"\"\<\\t\>\"", "->", "\"\< \>\""}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringTrim", "[", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"str", ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<\\\\s+\>\"", "]"}], "->", 
           "\"\< \>\""}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Cos\>\"", "->", "\"\<cos\>\""}], ",", 
           RowBox[{"\"\<Sin\>\"", "->", "\"\<sin\>\""}], ",", 
           RowBox[{"\"\<Csc\>\"", "->", "\"\<csc\>\""}], ",", 
           RowBox[{"\"\<**\>\"", "->", "\"\<.^\>\""}], ",", 
           RowBox[{"\"\<*\>\"", "->", "\"\<.*\>\""}], ",", 
           RowBox[{"\"\</\>\"", "->", "\"\<./\>\""}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"replaceSum", "[", 
        RowBox[{"s_String", ",", "var_String"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s2", "=", "s"}], "}"}], ",", 
         RowBox[{
          RowBox[{"posList", "=", 
           RowBox[{"StringPosition", "[", 
            RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{"posList", "=!=", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{
             RowBox[{"p", "=", 
              RowBox[{"posList", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"slen", "=", 
              RowBox[{"StringLength", "[", "s2", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"idx", "=", 
              RowBox[{"p", "+", "4"}]}], ";", 
             RowBox[{"depth", "=", "1"}], ";", "\[IndentingNewLine]", 
             RowBox[{"While", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"idx", "<=", "slen"}], "&&", 
                RowBox[{"depth", ">", "0"}]}], ",", 
               RowBox[{
                RowBox[{"Which", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"idx", ",", "idx"}], "}"}]}], "]"}], "==", 
                   "\"\<(\>\""}], ",", 
                  RowBox[{"depth", "++"}], ",", 
                  RowBox[{
                   RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"idx", ",", "idx"}], "}"}]}], "]"}], "==", 
                   "\"\<)\>\""}], ",", 
                  RowBox[{"depth", "--"}], ",", "True", ",", "Null"}], "]"}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"idx", "++"}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"depth", ">", "0"}], ",", 
               RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"find", " ", "top"}], "-", 
               RowBox[{
               "level", " ", "commas", " ", "inside", " ", "this", " ", "Sum", 
                RowBox[{"(", "...", ")"}]}]}], "*)"}], 
             RowBox[{"commaPosList", "=", 
              RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"kkLocal", "=", 
                  RowBox[{"p", "+", "4"}]}], ",", 
                 RowBox[{"dLocal", "=", "1"}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"While", "[", 
                 RowBox[{
                  RowBox[{"kkLocal", "<", 
                   RowBox[{"idx", "-", "1"}]}], ",", 
                  RowBox[{
                   RowBox[{"Which", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"kkLocal", ",", "kkLocal"}], "}"}]}], "]"}], 
                    "==", "\"\<(\>\""}], ",", 
                    RowBox[{"dLocal", "++"}], ",", 
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"kkLocal", ",", "kkLocal"}], "}"}]}], "]"}], 
                    "==", "\"\<)\>\""}], ",", 
                    RowBox[{"dLocal", "--"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"kkLocal", ",", "kkLocal"}], "}"}]}], "]"}], 
                    "==", "\"\<,\>\""}], "&&", 
                    RowBox[{"dLocal", "==", "1"}]}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"commaPosList", ",", "kkLocal"}], "]"}], ",", 
                    "True", ",", "Null"}], "]"}], ";", "\[IndentingNewLine]", 
                   
                   RowBox[{"kkLocal", "++"}], ";"}]}], "]"}], ";"}]}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "commaPosList", "]"}], ">=", "1"}], 
               ",", 
               RowBox[{
                RowBox[{"args", "=", 
                 RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"prev", "=", 
                 RowBox[{"p", "+", "4"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"For", "[", 
                 RowBox[{
                  RowBox[{"j", "=", "1"}], ",", 
                  RowBox[{"j", "<=", 
                   RowBox[{"Length", "[", "commaPosList", "]"}]}], ",", 
                  RowBox[{"j", "++"}], ",", 
                  RowBox[{
                   RowBox[{"seg", "=", 
                    RowBox[{"StringTrim", "[", 
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"prev", ",", 
                    RowBox[{
                    RowBox[{"commaPosList", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", "1"}]}], "}"}]}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"args", ",", "seg"}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"prev", "=", 
                    RowBox[{
                    RowBox[{"commaPosList", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", "1"}]}], ";"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"seg", "=", 
                 RowBox[{"StringTrim", "[", 
                  RowBox[{"StringTake", "[", 
                   RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"prev", ",", 
                    RowBox[{"idx", "-", "2"}]}], "}"}]}], "]"}], "]"}]}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"args", ",", "seg"}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"inner", "=", 
                 RowBox[{"args", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                 "detect", " ", "KroneckerDelta", " ", "selectors", " ", 
                  "inside", " ", "inner"}], "*)"}], 
                RowBox[{"kdPairs", "=", 
                 RowBox[{"StringCases", "[", 
                  RowBox[{"inner", ",", 
                   RowBox[{
                    RowBox[{
                    "RegularExpression", "[", 
                    "\"\<KroneckerDelta\\\\s*\\\\(\\\\s*([^,]+)\\\\s*,\\\\s*([\
^\\\\)]+)\\\\s*\\\\)\>\"", "]"}], ":>", 
                    RowBox[{"{", 
                    RowBox[{"\"\<$1\>\"", ",", "\"\<$2\>\""}], "}"}]}]}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"kdPairs", "=!=", 
                   RowBox[{"{", "}"}]}], ",", 
                  RowBox[{
                   RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"StringTrim", "[", 
                    RowBox[{"kdPairs", "[", 
                    RowBox[{"[", 
                    RowBox[{"jj", ",", "2"}], "]"}], "]"}], "]"}], "===", 
                    "var"}], ",", 
                    RowBox[{
                    RowBox[{"new", "=", 
                    RowBox[{"StringReplace", "[", 
                    RowBox[{"inner", ",", 
                    RowBox[{"var", "->", 
                    RowBox[{"StringTrim", "[", 
                    RowBox[{"kdPairs", "[", 
                    RowBox[{"[", 
                    RowBox[{"jj", ",", "1"}], "]"}], "]"}], "]"}]}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"jj", ",", 
                    RowBox[{"Length", "[", "kdPairs", "]"}]}], "}"}]}], "]"}],
                    ";", "\[IndentingNewLine]", 
                   RowBox[{"posList", "=", 
                    RowBox[{"StringPosition", "[", 
                    RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{"fallback", " ", "to", " ", "sum", 
                  RowBox[{"(", 
                   RowBox[{"...", ",", "3"}], ")"}], " ", "when", " ", 
                  "appropriate"}], "*)"}], 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "[", "args", "]"}], ">=", "2"}], "&&", 
                   RowBox[{"StringMatchQ", "[", 
                    RowBox[{
                    RowBox[{"args", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{"RegularExpression", "[", 
                    RowBox[{
                    "\"\<\\\\s*\>\"", "<>", "var", "<>", "\"\<\\\\s*\>\""}], 
                    "]"}]}], "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"new", "=", 
                    RowBox[{
                    "\"\<sum(\>\"", "<>", "inner", "<>", "\"\<,3)\>\""}]}], 
                   ";", "\[IndentingNewLine]", 
                   RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "args", "]"}], ">=", "2"}], "&&", 
                    RowBox[{"StringMatchQ", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "args", "]"}], ",", 
                    RowBox[{"RegularExpression", "[", 
                    RowBox[{
                    "\"\<\\\\s*\>\"", "<>", "var", "<>", "\"\<\\\\s*\>\""}], 
                    "]"}]}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"inner", "=", 
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"Riffle", "[", 
                    RowBox[{
                    RowBox[{"Most", "[", "args", "]"}], ",", "\"\<,\>\""}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"new", "=", 
                    RowBox[{
                    "\"\<sum(\>\"", "<>", "inner", "<>", "\"\<,3)\>\""}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"posList", "=", 
                    RowBox[{"Delete", "[", 
                    RowBox[{"posList", ",", 
                    RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";"}],
                ",", 
               RowBox[{
                RowBox[{"posList", "=", 
                 RowBox[{"Delete", "[", 
                  RowBox[{"posList", ",", 
                   RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                
                RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"posList", "=", 
              RowBox[{"StringPosition", "[", 
               RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";"}]}], "]"}], 
          ";", "\[IndentingNewLine]", "s2"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"end", " ", "replaceSum"}], "*)"}], 
      RowBox[{"str", "=", 
       RowBox[{"replaceSum", "[", 
        RowBox[{"str", ",", "\"\<ms\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"replaceSum", "[", 
        RowBox[{"str", ",", "\"\<mb\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"replaceSum", "[", 
        RowBox[{"str", ",", "\"\<m\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<S(ms)\>\"", "->", "\"\<S\>\""}], ",", 
           RowBox[{"\"\<Sp(ms)\>\"", "->", "\"\<Sp\>\""}], ",", 
           RowBox[{"\"\<Spp(ms)\>\"", "->", "\"\<Spp\>\""}], ",", 
           RowBox[{"\"\<Bs(mb)\>\"", "->", "\"\<Bs\>\""}], ",", 
           RowBox[{"\"\<Bsp(mb)\>\"", "->", "\"\<Bsp\>\""}], ",", 
           RowBox[{"\"\<Bspp(mb)\>\"", "->", "\"\<Bspp\>\""}], ",", 
           RowBox[{"\"\<KroneckerDelta(kp,kp)\>\"", "->", "\"\<1\>\""}]}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"StringTrim", "[", "str", "]"}]}]}], "]"}]}], "\n"}]], "Input",
