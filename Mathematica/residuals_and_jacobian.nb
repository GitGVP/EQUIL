  RowBox[{"jacTrial", "=", 
   RowBox[{"jacNew", "/.", " ", "filteredRulesList"}]}], ";"}]}], "Input",Expr\
essionUUID->"d650a1c9-41fc-4e71-b4bc-88eaca8bd3f9"],

