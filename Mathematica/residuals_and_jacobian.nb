                    RowBox[{"args", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{"RegularExpression", "[", 
                    RowBox[{
                    "\"\<\\\\s*\>\"", "<>", "var", "<>", "\"\<\\\\s*\>\""}], 
                    "]"}]}], "]"}]}], ",", 
