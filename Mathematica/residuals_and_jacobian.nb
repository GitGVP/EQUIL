                 RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"slen", "=", 
              RowBox[{"StringLength", "[", "s2", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"idx", "=", 
              RowBox[{"p", "+", "4"}]}], ";", 
