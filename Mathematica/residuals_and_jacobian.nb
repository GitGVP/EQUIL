                    RowBox[{"new", "=", 
                    RowBox[{
                    "\"\<sum(\>\"", "<>", "inner", "<>", "\"\<,3)\>\""}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"posList", "=", 
                    RowBox[{"Delete", "[", 
                    RowBox[{"posList", ",", 
                    RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";"}],
                ",", 
               RowBox[{
