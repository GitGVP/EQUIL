Cell[BoxData[{
 RowBox[{
  RowBox[{"presentT", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"jacNew", ",", 
      RowBox[{
       RowBox[{"s_Symbol", "/;", 
        RowBox[{"StringMatchQ", "[", 
         RowBox[{
          RowBox[{"SymbolName", "[", "s", "]"}], ",", 
          RowBox[{"\"\<T\>\"", "~~", 
           RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ":>", "s"}], ",", 
      "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"invRulesJac", "=", 
   RowBox[{"Association", "@", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"rule", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"lhs", "=", 
               RowBox[{"rule", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"rhs", "=", 
               RowBox[{"rule", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "tk", ",", "exp", ",", 
              "val"}], "}"}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "find", " ", "first", " ", "T", " ", "symbol", " ", "in", " ", 
               "RHS"}], ",", 
              RowBox[{"if", " ", "any"}]}], "*)"}], 
            RowBox[{
             RowBox[{"tk", "=", 
              RowBox[{"FirstCase", "[", 
               RowBox[{"rhs", ",", 
                RowBox[{
                 RowBox[{"s_Symbol", "/;", 
                  RowBox[{"isTSym", "[", "s", "]"}]}], ":>", "s"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"tk", "===", 
                 RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}]}], "||", 
                RowBox[{"!", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"presentT", ",", "tk"}], "]"}]}]}], ",", 
               RowBox[{"(*", 
                RowBox[{"skip", " ", "rules", " ", "that", " ", 
                 RowBox[{"don", "'"}], "t", " ", "define", " ", "a", " ", 
                 "present", " ", "T"}], "*)"}], "Nothing", ",", 
               RowBox[{"(*", 
                RowBox[{"compute", " ", "leading", " ", "exponent", " ", 
                 RowBox[{"(", "safe", ")"}], " ", "and", " ", "the", " ", 
                 "LO", " ", "coeff", " ", "of", " ", 
                 RowBox[{"lhs", "/", 
                  RowBox[{"\[Epsilon]", "^", "exp"}]}]}], "*)"}], 
               RowBox[{
                RowBox[{"exp", "=", 
                 RowBox[{"Quiet", "@", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Series", "[", 
