              "\[IndentingNewLine]", 
              RowBox[{"WriteString", "[", 
               RowBox[{"stream", ",", 
                RowBox[{"\"\<\\tT\>\"", "<>", "idx", "<>", "\"\< = \>\"", "<>", 
