                   RowBox[{"ToString", "[", "j", "]"}], "<>", 
                   "\"\<, rowsF, :) = reshape(\>\"", "<>", "\"\<j\>\"", "<>", 
                   
                   RowBox[{"ToString", "[", "d", "]"}], "<>", 
                   RowBox[{"ToString", "[", "j", "]"}], "<>", 
                   "\"\<F_FFT(:, mF+1).',\>\"", "<>", 
                   "\"\< [1,1,nmF, Nq]);\\n\\n\>\""}]}], "]"}], ";"}]}], 
              "]"}], ";"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], ";"}], ",", 
