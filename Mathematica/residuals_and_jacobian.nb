 RowBox[{
  RowBox[{"rulesJac", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"exprs", ",", "counted", ",", "filtered", ",", "sorted"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"exprs", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"jacTotal", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
