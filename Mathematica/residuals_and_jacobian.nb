Cell[BoxData[{
 RowBox[{
  RowBox[{"jacNew", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"el", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"LeafCount", "[", "el", "]"}], "<", "1000"}], ",", 
         RowBox[{"Simplify", "[", "el", "]"}], ",", "el"}], "]"}]}], "]"}], 
     ",", "jacNew", ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
