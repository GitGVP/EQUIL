      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\t%% Construct J\n    totalDofs = dof_count * (3 + Nb) + \
(dof_count-1) *Ns;\n    nCols = (3+ Nb + Ns)^2 * Nq;\n    % precomputed: \
M_extended (totalDofs x nCols), P_templates{d} with fields i,j,v_template\n   \
 J = spalloc(totalDofs, totalDofs, 1 * nnz(M_extended));  % or a tighter nnz \
estimate\n\n    for d = 1:3\n        % Extract jacobian block and flatten in \
the SAME order P_templates was built.\n        jac_d = \
squeeze(jacTotal(d,:,:,:));    % size: [nProfiles, nProfiles, Nq] \
(alpha,gamma,q)\n        % permute to [q, gamma, alpha] then linearize -> \
ordering matches P_templates{d}.i\n        jacTotal_flat = \
reshape(permute(jac_d, [3, 1, 2]), [], 1);   % length == nCols\n\n        % \
Row-scale P template by jac values (this gives diag(jac)*P_extended)\n        \
vP_scaled = P_templates{d}.v_template .* jacTotal_flat(P_templates{d}.i);\n\n \
       % Create sparse scaled-P and accumulate J via M_extended * P_scaled\n  \
      P_scaled = sparse(P_templates{d}.i, P_templates{d}.j, vP_scaled, nCols, \
totalDofs);\n        J = J + M_extended * P_scaled;\n    end\\n\>\""}], "]"}],
