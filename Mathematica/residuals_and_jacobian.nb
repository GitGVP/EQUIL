        "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tfor lp = 0:Nb-1\\n\>\""}], "]"}], ";", 
       "\n", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"jacExpr", "[", 
