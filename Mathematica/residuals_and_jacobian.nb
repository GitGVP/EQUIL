         RowBox[{"d", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tend\\n\\n\>\""}], "]"}], ";", "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "resB"}]}], " ", 
         RowBox[{"modes", "--"}]}], "-"}], "*)"}], 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\t% --- resB modes ---\\n\>\""}], "]"}], 
      ";", "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"scalar", " ", "3", "x3", " ", "blocks"}], "->", 
        RowBox[{
         RowBox[{"j11B", "..."}], " ", "j33B", " ", "assigned", " ", "per", 
         " ", "m"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"jacExpr", "[", 
                RowBox[{"[", 
                 RowBox[{"d", ",", "j", ",", "3"}], "]"}], "]"}], "=!=", 
               "0"}], ",", 
              RowBox[{
               RowBox[{"WriteString", "[", 
                RowBox[{"stream", ",", 
                 RowBox[{"\"\<\\t\>\"", "<>", "\"\<j\>\"", "<>", 
                  RowBox[{"ToString", "[", "d", "]"}], "<>", 
                  RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<B = \>\"", "<>", 
                  RowBox[{"ToMatlab", "[", 
                   RowBox[{"jacExpr", "[", 
                    RowBox[{"[", 
                    RowBox[{"d", ",", "j", ",", "3"}], "]"}], "]"}], "]"}], 
                  "<>", "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"WriteString", "[", 
                RowBox[{"stream", ",", 
                 RowBox[{"\"\<\\t\>\"", "<>", "\"\<j\>\"", "<>", 
                  RowBox[{"ToString", "[", "d", "]"}], "<>", 
                  RowBox[{"ToString", "[", "j", "]"}], "<>", 
                  "\"\<B_FFT = real(fft(\>\"", "<>", "\"\<j\>\"", "<>", 
                  RowBox[{"ToString", "[", "d", "]"}], "<>", 
                  RowBox[{"ToString", "[", "j", "]"}], "<>", 
                  "\"\<B, [], 2)) / Ntheta;\\n\>\""}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"WriteString", "[", 
                RowBox[{"stream", ",", 
                 RowBox[{"\"\<\\t\>\"", "<>", "\"\<jacTotal(\>\"", "<>", 
                  RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<,\>\"", "<>", 
                  RowBox[{"ToString", "[", "j", "]"}], "<>", 
                  "\"\<, rowsB, :) = reshape(\>\"", "<>", "\"\<j\>\"", "<>", 
                  RowBox[{"ToString", "[", "d", "]"}], "<>", 
                  RowBox[{"ToString", "[", "j", "]"}], "<>", 
                  "\"\<B_FFT(:, mB+1).', [1,1,nmB, Nq]);\\n\\n\>\""}]}], 
                "]"}], ";"}]}], "]"}], ";"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"(*", 
       RowBox[{"derivatives", " ", "wrt", " ", "B_l", " ", 
        RowBox[{"(", "bundle", ")"}], " ", "for", " ", "resB"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", "\"\<\\t% derivatives wrt B_l (bundle)\\n\>\""}], "]"}],
       ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tfor lp = 0:Nb-1\\n\>\""}], "]"}], ";", 
      "\n", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"jacExpr", "[", 
             RowBox[{"[", 
              RowBox[{"d", ",", "4", ",", "3"}], "]"}], "]"}], "=!=", "0"}], 
           ",", 
           RowBox[{
            RowBox[{"WriteString", "[", 
             RowBox[{"stream", ",", 
              RowBox[{"\"\<\\t\\t\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<3lpB = \>\"", "<>", 
               RowBox[{"ToMatlab", "[", 
                RowBox[{"jacExpr", "[", 
                 RowBox[{"[", 
                  RowBox[{"d", ",", "4", ",", "3"}], "]"}], "]"}], "]"}], 
               "<>", "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"WriteString", "[", 
             RowBox[{"stream", ",", 
              RowBox[{"\"\<\\t\\t\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", 
               "\"\<3lpB_FFT = real(fft(\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", 
               "\"\<3lpB, [], 2)) / Ntheta;\\n\>\""}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"WriteString", "[", 
             RowBox[{"stream", ",", 
              RowBox[{"\"\<\\t\\t\>\"", "<>", "\"\<jacTotal(\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", 
               "\"\<, 3+lp+1, rowsB, :) = reshape(\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", 
               "\"\<3lpB_FFT(:, mB+1).', [1,1,nmB, Nq]);\\n\>\""}]}], "]"}], 
            ";"}]}], "]"}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tend\\n\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"derivatives", " ", "wrt", " ", "S_k", " ", 
         RowBox[{"(", "bundle", ")"}], " ", "for", " ", "resB"}], ",", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"2", ".."}], "Ns"}], "+", "1"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\t% derivatives wrt S_k (bundle), k=2..Ns+1\\n\>\""}], "]"}], 
      ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tfor kp = 2:(Ns+1)\\n\>\""}], "]"}], ";",
       "\n", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"jacExpr", "[", 
             RowBox[{"[", 
              RowBox[{"d", ",", "5", ",", "3"}], "]"}], "]"}], "=!=", "0"}], 
           ",", 
           RowBox[{
            RowBox[{"WriteString", "[", 
             RowBox[{"stream", ",", 
              RowBox[{"\"\<\\t\\t\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<3kpB = \>\"", "<>", 
               RowBox[{"ToMatlab", "[", 
                RowBox[{"jacExpr", "[", 
                 RowBox[{"[", 
                  RowBox[{"d", ",", "5", ",", "3"}], "]"}], "]"}], "]"}], 
               "<>", "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"WriteString", "[", 
             RowBox[{"stream", ",", 
              RowBox[{"\"\<\\t\\t\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", 
               "\"\<3kpB_FFT = real(fft(\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", 
               "\"\<3kpB, [], 2)) / Ntheta;\\n\>\""}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"WriteString", "[", 
             RowBox[{"stream", ",", 
              RowBox[{"\"\<\\t\\t\>\"", "<>", "\"\<jacTotal(\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<, \>\"", "<>", 
               "\"\<3 + Nb + (kp - 1)\>\"", "<>", 
               "\"\<, rowsB, :) = reshape(\>\"", "<>", "\"\<j\>\"", "<>", 
               RowBox[{"ToString", "[", "d", "]"}], "<>", 
               "\"\<3kpB_FFT(:, mB+1).', [1,1,nmB, Nq]);\\n\>\""}]}], "]"}], 
            ";"}]}], "]"}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tend\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\t%% Construct J\n    totalDofs = dof_count * (3 + Nb) + \
(dof_count-1) *Ns;\n    nCols = (3+ Nb + Ns)^2 * Nq;\n    % precomputed: \
M_extended (totalDofs x nCols), P_templates{d} with fields i,j,v_template\n   \
 J = spalloc(totalDofs, totalDofs, 1 * nnz(M_extended));  % or a tighter nnz \
estimate\n\n    for d = 1:3\n        % Extract jacobian block and flatten in \
the SAME order P_templates was built.\n        jac_d = \
squeeze(jacTotal(d,:,:,:));    % size: [nProfiles, nProfiles, Nq] \
(alpha,gamma,q)\n        % permute to [q, gamma, alpha] then linearize -> \
ordering matches P_templates{d}.i\n        jacTotal_flat = \
reshape(permute(jac_d, [3, 1, 2]), [], 1);   % length == nCols\n\n        % \
Row-scale P template by jac values (this gives diag(jac)*P_extended)\n        \
vP_scaled = P_templates{d}.v_template .* jacTotal_flat(P_templates{d}.i);\n\n \
       % Create sparse scaled-P and accumulate J via M_extended * P_scaled\n  \
      P_scaled = sparse(P_templates{d}.i, P_templates{d}.j, vP_scaled, nCols, \
totalDofs);\n        J = J + M_extended * P_scaled;\n    end\\n\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<end\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Close", "[", "stream", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Wrote MATLAB file \\\"\>\"", ",", "fileName", ",", 
        "\"\<\\\" with <\>\"", ",", "funcName", ",", "\"\<>.\>\""}], "]"}], 
      ";"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.974885030379101*^9, 3.974885065358697*^9}, {
