Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"WriteJac", "[", 
     RowBox[{"fileName_String", ",", "funcName_String", ",", "jacExpr_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"stream", ",", "argsStr", ",", "dimsJac"}], "}"}], ",", 
      RowBox[{
       RowBox[{"argsStr", "=", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\"\<r\>\"", ",", "\"\<x\>\"", ",", "\"\<epsilon\>\"", ",", 
            "\"\<omega\>\"", ",", "\"\<kinetic_profiles\>\"", ",", 
            "\"\<q\>\"", ",", "\"\<qp\>\"", ",", "\"\<P0\>\"", ",", 
            "\"\<P1\>\"", ",", "\"\<P2\>\"", ",", "\"\<dof_count\>\"", ",", 
            "\"\<Nb\>\"", ",", "\"\<Sbc\>\"", ",", "\"\<P_templates\>\"", 
            ",", "\"\<M_extended\>\"", ",", "\"\<equation_of_state\>\""}], 
           "}"}], ",", "\"\<,\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dimsJac", "=", 
        RowBox[{"Dimensions", "[", "jacExpr", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"stream", "=", 
        RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", 
         RowBox[{
         "\"\<function J = \>\"", "<>", "funcName", "<>", "\"\<(\>\"", "<>", 
          "argsStr", "<>", "\"\<)\\n\>\""}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tNq = numel(r);\n\\tNs = numel(Sbc);\n\\tnRes = 3+Nb+Ns;\n\
\\t[t2, t2p, delta, deltap, deltapp, P, Pp, Ppp, Bs, Bsp, S, Sp, Spp] = ...\n \
     equil_unpack_state(x, dof_count, Nb, Sbc, P0, P1, P2);\n\\tms = \
reshape(linspace(2,Ns+1,Ns), [1,1,Ns]);\n\\tmb = reshape(0:(Nb-1), [1,1,Nb]);\
\n\\tBB = 1 + epsilon.*sum(Bs.*cos(mb.*omega),3);\n\\tRR = 1 - \
delta.*epsilon.^2 + epsilon.^3.*P.*cos(omega) + epsilon.*r.*cos(omega) + \
epsilon.^2.*sum(cos((-1 + ms).*omega).*S,3);\n[dbetapardB0, ...\n        \
dbetapardr, dbetapardB, dbetapardR, ...\n        d2betapardB2, d2betapardrdB, \
d2betapardRdB,d2betapardrdR,d2betapardR2,...\n\
\\t\\td3betapardrdB2,d3betapardB3,d3betapardBdR2,d3betapardB2dR,\
d3betapardrdRdB] = equation_of_state(kinetic_profiles,r,RR,BB);\n    Ntheta = \
numel(omega);\n    mF   = [0,1,2:(Ns+1)];\n    rowsF = [1,2,(2 + Nb + \
(2:(Ns+1)))];\n    mB   = 0:(Nb-1);\n    rowsB = 3 + (1:Nb); \n    nmF = \
numel(mF);\n    nmB = numel(mB);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Tn", " ", "definitions", " ", "from", " ", "invRules"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"idx", "=", 
             RowBox[{"StringReplace", "[", 
              RowBox[{
               RowBox[{"ToString", "[", 
                RowBox[{"filteredRulesList", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", 
               RowBox[{"\"\<T\>\"", "->", "\"\<\>\""}]}], "]"}]}], "}"}], ",", 
           RowBox[{"WriteString", "[", 
            RowBox[{"stream", ",", 
             RowBox[{"\"\<\\tT\>\"", "<>", "idx", "<>", "\"\< = \>\"", "<>", 
              RowBox[{"ToMatlab", "[", 
               RowBox[{"filteredRulesList", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
              "\"\<;\\n\>\""}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "filteredRulesList", "]"}]}], "}"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
