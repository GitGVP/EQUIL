                    RowBox[{"jj", ",", 
                    RowBox[{"Length", "[", "kdPairs", "]"}]}], "}"}]}], "]"}],
                    ";", "\[IndentingNewLine]", 
                   RowBox[{"posList", "=", 
                    RowBox[{"StringPosition", "[", 
                    RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{"fallback", " ", "to", " ", "sum", 
                  RowBox[{"(", 
                   RowBox[{"...", ",", "3"}], ")"}], " ", "when", " ", 
                  "appropriate"}], "*)"}], 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "[", "args", "]"}], ">=", "2"}], "&&", 
                   RowBox[{"StringMatchQ", "[", 
