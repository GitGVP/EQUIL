                    RowBox[{
                    "\"\<\\\\s*\>\"", "<>", "var", "<>", "\"\<\\\\s*\>\""}], 
                    "]"}]}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"inner", "=", 
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"Riffle", "[", 
                    RowBox[{
                    RowBox[{"Most", "[", "args", "]"}], ",", "\"\<,\>\""}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"new", "=", 
                    RowBox[{
                    "\"\<sum(\>\"", "<>", "inner", "<>", "\"\<,3)\>\""}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"posList", "=", 
                    RowBox[{"Delete", "[", 
                    RowBox[{"posList", ",", 
                    RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";"}],
                ",", 
               RowBox[{
                RowBox[{"posList", "=", 
                 RowBox[{"Delete", "[", 
                  RowBox[{"posList", ",", 
                   RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                
                RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"posList", "=", 
              RowBox[{"StringPosition", "[", 
               RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";"}]}], "]"}], 
          ";", "\[IndentingNewLine]", "s2"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"end", " ", "replaceSum"}], "*)"}], 
      RowBox[{"str", "=", 
       RowBox[{"replaceSum", "[", 
        RowBox[{"str", ",", "\"\<ms\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"replaceSum", "[", 
        RowBox[{"str", ",", "\"\<mb\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"replaceSum", "[", 
        RowBox[{"str", ",", "\"\<m\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<S(ms)\>\"", "->", "\"\<S\>\""}], ",", 
           RowBox[{"\"\<Sp(ms)\>\"", "->", "\"\<Sp\>\""}], ",", 
           RowBox[{"\"\<Spp(ms)\>\"", "->", "\"\<Spp\>\""}], ",", 
           RowBox[{"\"\<Bs(mb)\>\"", "->", "\"\<Bs\>\""}], ",", 
           RowBox[{"\"\<Bsp(mb)\>\"", "->", "\"\<Bsp\>\""}], ",", 
           RowBox[{"\"\<Bspp(mb)\>\"", "->", "\"\<Bspp\>\""}], ",", 
           RowBox[{"\"\<KroneckerDelta(kp,kp)\>\"", "->", "\"\<1\>\""}]}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"StringTrim", "[", "str", "]"}]}]}], "]"}]}], "\n"}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"fc1432dd-f8d7-473e-bb7e-b00e6c4fb741"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"presentTres", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"resTotal", ",", 
      RowBox[{
       RowBox[{"s_Symbol", "/;", 
        RowBox[{"StringMatchQ", "[", 
         RowBox[{
          RowBox[{"SymbolName", "[", "s", "]"}], ",", 
          RowBox[{"\"\<T\>\"", "~~", 
           RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ":>", "s"}], ",", 
      "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WriteRes", "[", 
    RowBox[{"fileName_String", ",", "funcName_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stream", ",", "argsStr", ",", "nRes"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"argsStr", "=", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<r\>\"", ",", "\"\<x\>\"", ",", "\"\<epsilon\>\"", ",", 
           "\"\<omega\>\"", ",", "\"\<kinetic_profiles\>\"", ",", "\"\<q\>\"",
            ",", "\"\<qp\>\"", ",", "\"\<P0\>\"", ",", "\"\<P1\>\"", ",", 
           "\"\<P2\>\"", ",", "\"\<M_profiles\>\"", ",", "\"\<dof_count\>\"", 
           ",", " ", "\"\<Nb\>\"", ",", " ", "\"\<Sbc\>\"", ",", 
           "\"\<equation_of_state\>\""}], "}"}], ",", "\"\<,\>\""}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"stream", "=", 
       RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "HEADER", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{
        "\"\<function R = \>\"", "<>", "funcName", "<>", "\"\<(\>\"", "<>", 
         "argsStr", "<>", "\"\<)\\n\>\""}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tN = numel(r);\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tNs = numel(Sbc);\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tnRes = 3+Nb+Ns;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Unknowns", " ", "unpacking"}], "*)"}], "\[IndentingNewLine]", 
      
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tt2_c    = x(1:dof_count);\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", "\"\<\\tdelta_c = x(dof_count+1:2*dof_count);\\n\>\""}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", "\"\<\\tP_c = x(2*dof_count+1:3*dof_count);\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tBs_c    = reshape(x(3*dof_count+1:(3+Nb)*dof_count), \
[dof_count, 1, Nb]);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tBs_flat   = reshape(Bs_c, size(Bs_c,1), []);        % \
dof_count x Ns\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS_unkn     = reshape(x((3+Nb)*dof_count+1:end), [dof_count-1, \
1, Ns]);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS_c     = cat(1, S_unkn, reshape(Sbc, [1, 1, Ns]));\\n\>\""}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS_flat   = reshape(S_c, size(S_c,1), []);        % dof_count \
x Ns\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Reconstruction", " ", "at", " ", "quadrature", " ", "points"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tt2      = P0 * t2_c;\\n\>\""}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tt2p     = P1 * t2_c;\\n\>\""}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tdelta   = P0 * delta_c;\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tdeltap  = P1 * delta_c;\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tdeltapp = P2 * delta_c;\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tP   = P0 * P_c;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tPp  = P1 * P_c;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tPpp = P2 * P_c;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tBs       = reshape(P0 * Bs_flat, N, 1, []);\\n\\tBsp = \
reshape(P1 * Bs_flat, N, 1, []);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS       = reshape(P0 * S_flat, N, 1, []);\\n\\tSp = \
reshape(P1 * S_flat, N, 1, []);\\n\\tSpp = reshape(P2 * S_flat, N, 1, []);\\n\
\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tresTotal = zeros(nRes,N);\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tms = reshape(linspace(2,Ns+1,Ns), [1,1,Ns]);\\n\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tmb = reshape(linspace(1,Nb,Nb), [1,1,Nb]);\\n\>\""}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{"\"\<\\tRR = \>\"", "<>", 
         RowBox[{"ToMatlab", "[", 
          RowBox[{"R", "[", 
           RowBox[{"r", ",", "\[Omega]"}], "]"}], "]"}], "<>", 
         "\"\<;\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{"\"\<\\tBB = \>\"", "<>", 
         RowBox[{"ToMatlab", "[", 
          RowBox[{"Bhat", "[", 
           RowBox[{"r", ",", "\[Omega]"}], "]"}], "]"}], "<>", 
         "\"\<;\\n\\n\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Equation", " ", "of", " ", "state", " ", "part"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\t[dbetapardB0, ...\n        dbetapardr, dbetapardB, \
dbetapardR, ...\n        d2betapardB2, d2betapardrdB, d2betapardRdB] = \
equation_of_state(kinetic_profiles,r,RR,BB);\\n\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Tn", " ", "definitions", " ", "from", " ", "invRules"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Tk", ",", "idx"}], "}"}], ",", 
          RowBox[{
           RowBox[{"Tk", "=", 
            RowBox[{
             RowBox[{"Keys", "[", "invRules", "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"presentTres", ",", "Tk"}], "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{"only", " ", "write", " ", "if", " ", "used"}], "*)"}], 
             
             RowBox[{
              RowBox[{"idx", "=", 
               RowBox[{"StringReplace", "[", 
                RowBox[{
                 RowBox[{"SymbolName", "[", "Tk", "]"}], ",", 
                 RowBox[{"\"\<T\>\"", "->", "\"\<\>\""}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"WriteString", "[", 
               RowBox[{"stream", ",", 
                RowBox[{"\"\<\\tT\>\"", "<>", "idx", "<>", "\"\< = \>\"", "<>", 
                 RowBox[{"ToMatlab", "[", 
                  RowBox[{"invRules", "[", "Tk", "]"}], "]"}], "<>", 
                 "\"\<;\\n\>\""}]}], "]"}]}]}], "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "invRules", "]"}]}], "}"}]}], "]"}], ";", 
      "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "Residuals", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{"\"\<\\tresF = \>\"", "<>", 
         RowBox[{"ToMatlab", "[", "resF", "]"}], "<>", "\"\<;\\n\>\""}]}], 
       "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{"\"\<\\tresB = \>\"", "<>", 
         RowBox[{"ToMatlab", "[", "resBB", "]"}], "<>", "\"\<;\\n\>\""}]}], 
       "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tresF_FFT = real(fft(resF, [], 2))/numel(omega);\\n\>\""}], 
       "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tresB_FFT = real(fft(resB, [], 2))/numel(omega);\\n\>\""}], 
       "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tmF = [0, 1, 2:(Ns+1)];\\n\>\""}], "]"}],
       ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\trowsF = [1, 2, (2 + Nb + (2:(Ns+1)))];\\n\>\""}], "]"}], ";", 
      "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tmB = 1:Nb;\\n\>\""}], "]"}], ";", "\n", 
      
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\trowsB = 3 + mB;\\n\>\""}], "]"}], ";", 
      "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tresTotal(rowsF, :) = resF_FFT(:, mF + 1).';\\n\>\""}], "]"}], 
      ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tresTotal(rowsB, :) = resB_FFT(:, mB + 1).';\\n\>\""}], "]"}], 
      ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{"\"\<\\tresTotal(3,:) = mean(\>\"", "<>", 
         RowBox[{"ToMatlab", "[", "resP", "]"}], "<>", "\"\<, 2);\\n\>\""}]}],
        "]"}], ";", "\n", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tR = M_profiles * reshape(resTotal.', [], 1);\\n\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<end\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Close", "[", "stream", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Wrote MATLAB file \[OpenCurlyDoubleQuote]\>\"", ",", "fileName", 
        ",", "\"\<\[CloseCurlyDoubleQuote] with <\>\"", ",", "funcName", ",", 
        "\"\<>.\>\""}], "]"}], ";"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WriteJac", "[", 
    RowBox[{"fileName_String", ",", "funcName_String", ",", "jacExpr_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stream", ",", "argsStr", ",", "dimsJac"}], "}"}], ",", 
     RowBox[{
      RowBox[{"argsStr", "=", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<r\>\"", ",", "\"\<x\>\"", ",", "\"\<epsilon\>\"", ",", 
           "\"\<omega\>\"", ",", "\"\<kinetic_profiles\>\"", ",", "\"\<q\>\"",
            ",", "\"\<qp\>\"", ",", "\"\<P0\>\"", ",", "\"\<P1\>\"", ",", 
           "\"\<P2\>\"", ",", "\"\<dof_count\>\"", ",", "\"\<Nb\>\"", ",", 
           "\"\<Sbc\>\"", ",", "\"\<P_templates\>\"", ",", 
           "\"\<M_extended\>\"", ",", "\"\<equation_of_state\>\""}], "}"}], 
         ",", "\"\<,\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dimsJac", "=", 
       RowBox[{"Dimensions", "[", "jacExpr", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"stream", "=", 
       RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{
        "\"\<function J = \>\"", "<>", "funcName", "<>", "\"\<(\>\"", "<>", 
         "argsStr", "<>", "\"\<)\\n\>\""}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tNq = numel(r);\n\\tNs = numel(Sbc);\n\\tnRes = 3+Nb+Ns;\n\
\\tt2_c    = x(1:dof_count);\n\\tdelta_c = x(dof_count+1:2*dof_count);\n\
\\tP_c = x(2*dof_count+1:3*dof_count);\n\\tBs_c    = \
reshape(x(3*dof_count+1:(3+Nb)*dof_count), [dof_count, 1, Nb]);\n\\tBs_flat   \
= reshape(Bs_c, size(Bs_c,1), []);        % dof_count x Ns\n\\tS_unkn     = \
reshape(x((3+Nb)*dof_count+1:end), [dof_count-1, 1, Ns]);\n\\tS_c     = \
cat(1, S_unkn, reshape(Sbc, [1, 1, Ns]));\n\\tS_flat   = reshape(S_c, \
size(S_c,1), []);        % dof_count x Ns\n\\tt2      = P0 * t2_c;\n\\tt2p    \
 = P1 * t2_c;\n\\tdelta   = P0 * delta_c;\n\\tdeltap  = P1 * delta_c;\n\
\\tdeltapp = P2 * delta_c;\n\\tP   = P0 * P_c;\n\\tPp  = P1 * P_c;\n\\tPpp = \
P2 * P_c;\n\\tBs       = reshape(P0 * Bs_flat, Nq, 1, []);\n\\tBsp = \
reshape(P1 * Bs_flat, Nq, 1, []);\n\\tS       = reshape(P0 * S_flat, Nq, 1, \
[]);\n\\tSp = reshape(P1 * S_flat, Nq, 1, []);\n\\tSpp = reshape(P2 * S_flat, \
Nq, 1, []);\n\\tms = reshape(linspace(2,Ns+1,Ns), [1,1,Ns]);\n\\tmb = \
reshape(linspace(1,Nb,Nb), [1,1,Nb]);\n\\tBB = 1 + \
epsilon.*sum(Bs.*cos(mb.*omega),3);\n\\tRR = 1 - delta.*epsilon.^2 + \
epsilon.^3.*P.*cos(omega) + epsilon.*r.*cos(omega) + epsilon.^2.*sum(cos((-1 \
+ ms).*omega).*S,3);\n[dbetapardB0, ...\n        dbetapardr, dbetapardB, \
dbetapardR, ...\n        d2betapardB2, d2betapardrdB, \
d2betapardRdB,d2betapardrdR,d2betapardR2,...\n\
\\t\\td3betapardrdB2,d3betapardB3,d3betapardBdR2,d3betapardB2dR,\
d3betapardrdRdB] = equation_of_state(kinetic_profiles,r,RR,BB);\n    Ntheta = \
numel(omega);\n    mF   = [0,1,2:(Ns+1)];\n    rowsF = [1,2,(2 + Nb + \
(2:(Ns+1)))];\n    mB   = 1:Nb;\n    rowsB = 3 + mB;\n    nmF = numel(mF);\n  \
  nmB = numel(mB);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Tn", " ", "definitions", " ", "from", " ", "invRules"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"idx", "=", 
            RowBox[{"StringReplace", "[", 
             RowBox[{
              RowBox[{"ToString", "[", 
               RowBox[{"filteredRulesList", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"\"\<T\>\"", "->", "\"\<\>\""}]}], "]"}]}], "}"}], ",", 
          
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{"\"\<\\tT\>\"", "<>", "idx", "<>", "\"\< = \>\"", "<>", 
             RowBox[{"ToMatlab", "[", 
              RowBox[{"filteredRulesList", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
             "\"\<;\\n\>\""}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "filteredRulesList", "]"}]}], "}"}]}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"jacTotal", " ", "prealloc"}], "*)"}], 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tjacTotal = zeros(3,nRes,nRes,Nq); % (which deriv, which \
equation, which profile)\\n\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "resF"}]}], " ", 
         RowBox[{"modes", "--"}]}], "-"}], "*)"}], 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\t% --- resF modes ---\\n\>\""}], "]"}], 
      ";", "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"scalar", " ", "3", "x3", " ", "blocks"}], "->", 
        RowBox[{
