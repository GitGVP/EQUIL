Cell[CellGroupData[{

Cell["Try with manual cutting (isotropic/static)", "Chapter",
 CellChangeTimes->{{3.986284873490385*^9, 
  3.986284887946961*^9}},ExpressionUUID->"0544ed35-2076-4518-affb-\
b301195e28b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], " ", "=", " ", 
   RowBox[{"\[Epsilon]", " ", "r", " ", 
    FractionBox[
     RowBox[{"t", "[", "r", "]"}], 
     RowBox[{" ", 
      RowBox[{"q", "[", "r", "]"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t", "[", "r_", "]"}], "=", " ", 
    RowBox[{"1", "-", 
     RowBox[{
      SuperscriptBox["\[Epsilon]", "2"], " ", 
      RowBox[{
       SuperscriptBox["betapar", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"0", ",", "1", ",", "1"}], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[Epsilon]", "2"], 
      RowBox[{"t2", "[", "r", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"C", " ", "coefficients", " ", "part"}], ",", " ", 
    RowBox[{"distribution", " ", "function", " ", "agnostic"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"betapar", "[", 
    RowBox[{"r_", ",", "B_", ",", "R_"}], "]"}], "=", 
   RowBox[{"beta", "[", "r", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]par", "[", 
    RowBox[{"r_", ",", "\[Omega]_"}], "]"}], "=", " ", 
   RowBox[{
    SuperscriptBox["\[Epsilon]", "2"], 
    RowBox[{"betapar", "[", 
     RowBox[{"r", ",", " ", 
      RowBox[{"Bhat", "[", 
       RowBox[{"r", ",", "\[Omega]"}], "]"}], ",", " ", 
      RowBox[{"R", "[", 
       RowBox[{"r", ",", "\[Omega]"}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]perp", "[", 
    RowBox[{"r_", ",", "\[Omega]_"}], "]"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Beta]par", "[", 
      RowBox[{"r", ",", "\[Omega]"}], "]"}], " ", "-", " ", 
     RowBox[{
      SuperscriptBox["\[Epsilon]", "2"], " ", 
      RowBox[{"Bhat", "[", 
       RowBox[{"r", ",", "\[Omega]"}], "]"}], 
      RowBox[{
       SuperscriptBox["betapar", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"r", ",", " ", 
        RowBox[{"Bhat", "[", 
         RowBox[{"r", ",", "\[Omega]"}], "]"}], ",", " ", 
        RowBox[{"R", "[", 
         RowBox[{"r", ",", "\[Omega]"}], "]"}]}], "]"}]}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]bar", "[", 
    RowBox[{"r_", ",", "\[Omega]_"}], "]"}], " ", "=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Beta]par", "[", 
      RowBox[{"r", ",", "\[Omega]"}], "]"}], "+", 
     RowBox[{"\[Beta]perp", "[", 
      RowBox[{"r", ",", "\[Omega]"}], "]"}]}], "2"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", 
    RowBox[{"r_", ",", "\[Omega]_"}], "]"}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Beta]par", "[", 
      RowBox[{"r", ",", "\[Omega]"}], "]"}], "-", 
     RowBox[{"\[Beta]perp", "[", 
      RowBox[{"r", ",", "\[Omega]"}], "]"}]}], 
    SuperscriptBox[
     RowBox[{"Bhat", "[", 
      RowBox[{"r", ",", "\[Omega]"}], "]"}], "2"]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"r_", ",", "\[Omega]_"}], "]"}], "=", 
   FractionBox[
    RowBox[{"t", "[", "r", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"\[Sigma]", "[", 
       RowBox[{"r", ",", "\[Omega]"}], "]"}]}], ")"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]R\[CapitalOmega]2", "[", 
     RowBox[{"r_", ",", "\[Omega]_"}], "]"}], "=", " ", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "2"], " ", 
     RowBox[{
      SuperscriptBox["betapar", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "0", ",", "1"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"r", ",", " ", 
       RowBox[{"Bhat", "[", 
        RowBox[{"r", ",", "\[Omega]"}], "]"}], ",", " ", 
       RowBox[{"R", "[", 
        RowBox[{"r", ",", "\[Omega]"}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Rescaled", " ", "directly", " ", "by", " ", 
    SuperscriptBox["\[Epsilon]", 
     RowBox[{"-", "2"}]], " ", "to", " ", "make", " ", "all", " ", "terms", 
    " ", 
    RowBox[{"O", "[", "1", "]"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Grot", " ", "=", 
   RowBox[{
    RowBox[{"-", " ", 
     SuperscriptBox["\[Epsilon]", 
      RowBox[{"-", "2"}]]}], " ", 
    RowBox[{"\[Rho]R\[CapitalOmega]2", "[", 
     RowBox[{"r", ",", "\[Omega]"}], "]"}], 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"R", "[", 
       RowBox[{"r", ",", "\[Omega]"}], "]"}], ",", "r"}], "]"}]}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GKr", " ", "=", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"f", "[", "r", "]"}], 
     RowBox[{"J", "[", 
      RowBox[{"r", ",", "\[Omega]"}], "]"}]], 
    RowBox[{"(", 
     RowBox[{"D", "[", " ", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"g\[Theta]\[Theta]", "[", 
          RowBox[{"r", ",", "\[Omega]"}], "]"}], 
         RowBox[{"J", "[", 
          RowBox[{"r", ",", "\[Omega]"}], "]"}]], 
        RowBox[{"f", "[", "r", "]"}]}], ",", "r"}], "]"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GK\[Omega]", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", " ", 
     FractionBox[
      RowBox[{"f", "[", "r", "]"}], 
      RowBox[{"J", "[", 
       RowBox[{"r", ",", "\[Omega]"}], "]"}]]}], 
    RowBox[{"D", "[", 
     RowBox[{
