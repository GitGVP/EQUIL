                   RowBox[{"ToString", "[", "d", "]"}], "<>", 
                   RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<F = \>\"", 
                   "<>", 
                   RowBox[{"ToMatlab", "[", 
                    RowBox[{"jacExpr", "[", 
                    RowBox[{"[", 
                    RowBox[{"d", ",", "j", ",", "1"}], "]"}], "]"}], "]"}], 
                   "<>", "\"\<;\\n\>\""}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"WriteString", "[", 
