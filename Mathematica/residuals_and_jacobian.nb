 RowBox[{
  RowBox[{
   RowBox[{"WriteRes", "[", 
    RowBox[{"fileName_String", ",", "funcName_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stream", ",", "argsStr", ",", "nRes"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"argsStr", "=", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<r\>\"", ",", "\"\<x\>\"", ",", "\"\<epsilon\>\"", ",", 
           "\"\<omega\>\"", ",", "\"\<kinetic_profiles\>\"", ",", "\"\<q\>\"",
            ",", "\"\<qp\>\"", ",", "\"\<P0\>\"", ",", "\"\<P1\>\"", ",", 
           "\"\<P2\>\"", ",", "\"\<M_profiles\>\"", ",", "\"\<dof_count\>\"", 
           ",", " ", "\"\<Nb\>\"", ",", " ", "\"\<Sbc\>\"", ",", 
           "\"\<equation_of_state\>\""}], "}"}], ",", "\"\<,\>\""}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"stream", "=", 
       RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "HEADER", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{
        "\"\<function R = \>\"", "<>", "funcName", "<>", "\"\<(\>\"", "<>", 
         "argsStr", "<>", "\"\<)\\n\>\""}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tN = numel(r);\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tNs = numel(Sbc);\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tnRes = 3+Nb+Ns;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Unknowns", " ", "unpacking"}], "*)"}], "\[IndentingNewLine]", 
      
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tt2_c    = x(1:dof_count);\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", "\"\<\\tdelta_c = x(dof_count+1:2*dof_count);\\n\>\""}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", "\"\<\\tP_c = x(2*dof_count+1:3*dof_count);\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tBs_c    = reshape(x(3*dof_count+1:(3+Nb)*dof_count), \
[dof_count, 1, Nb]);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tBs_flat   = reshape(Bs_c, size(Bs_c,1), []);        % \
dof_count x Ns\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS_unkn     = reshape(x((3+Nb)*dof_count+1:end), [dof_count-1, \
1, Ns]);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS_c     = cat(1, S_unkn, reshape(Sbc, [1, 1, Ns]));\\n\>\""}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS_flat   = reshape(S_c, size(S_c,1), []);        % dof_count \
x Ns\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Reconstruction", " ", "at", " ", "quadrature", " ", "points"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tt2      = P0 * t2_c;\\n\>\""}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tt2p     = P1 * t2_c;\\n\>\""}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tdelta   = P0 * delta_c;\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tdeltap  = P1 * delta_c;\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tdeltapp = P2 * delta_c;\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tP   = P0 * P_c;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tPp  = P1 * P_c;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tPpp = P2 * P_c;\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tBs       = reshape(P0 * Bs_flat, N, 1, []);\\n\\tBsp = \
reshape(P1 * Bs_flat, N, 1, []);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tS       = reshape(P0 * S_flat, N, 1, []);\\n\\tSp = \
reshape(P1 * S_flat, N, 1, []);\\n\\tSpp = reshape(P2 * S_flat, N, 1, []);\\n\
\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", "\"\<\\tresTotal = zeros(nRes,N);\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tms = reshape(linspace(2,Ns+1,Ns), [1,1,Ns]);\\n\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", "\"\<\\tmb = reshape(0:(Nb-1), [1,1,Nb]);\\n\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"stream", ",", 
        RowBox[{"\"\<\\tRR = \>\"", "<>", 
         RowBox[{"ToMatlab", "[", 
          RowBox[{"R", "[", 
