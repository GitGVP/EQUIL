Cell[BoxData[
 RowBox[{
  RowBox[{"rulesJac", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"exprs", ",", "counted", ",", "filtered", ",", "sorted"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"exprs", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"jacTotal", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{"r", ",", "\[Omega]"}], "]"}], "->", " ", "RR"}], ",", 
             
             RowBox[{
              RowBox[{"Bhat", "[", 
               RowBox[{"r", ",", "\[Omega]"}], "]"}], "->", " ", "BB"}]}], 
            "}"}]}], "]"}], ",", 
         RowBox[{"s_", "/;", 
          RowBox[{
           RowBox[{"Depth", "[", "s", "]"}], ">", "2"}]}], ",", 
         "\[Infinity]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Finished Cases, Flatten\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"counted", "=", 
       RowBox[{"Tally", "[", "exprs", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Finished Tally\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"filtered", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"counted", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], "&&", 
           RowBox[{
            RowBox[{"LeafCount", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ">", "100"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Finished filtering\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sorted", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"filtered", ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Finished sorting\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Association", "@", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pair", ",", "idx"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"expr", "=", 
                RowBox[{"pair", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", "exp", ",", "Tk", ",",
                "s"}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"s", "=", 
               RowBox[{"Quiet", "@", 
                RowBox[{"Check", "[", 
                 RowBox[{
                  RowBox[{"Series", "[", 
                   RowBox[{"expr", ",", 
                    RowBox[{"\[Epsilon]", "->", "0"}]}], "]"}], ",", 
                  "$Failed"}], "]"}]}]}], ";", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", "s", "]"}], "===", "SeriesData"}], ",", 
                
                RowBox[{"exp", "=", 
                 RowBox[{"s", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}], ",", 
                RowBox[{"exp", "=", "0"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Tk", "=", 
               RowBox[{"Symbol", "[", 
                RowBox[{"\"\<T\>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"idx", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"idx", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "25"}], "]"}], "==", 
                 "0"}], ",", 
                RowBox[{
                "Print", "[", "\"\<Finished 25 replacement rules\>\"", 
                 "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"expr", "->", 
               RowBox[{
                RowBox[{"\[Epsilon]", "^", "exp"}], "*", "Tk"}]}]}]}], 
            "]"}]}], "]"}], ",", "sorted"}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"b6192988-ce34-45a6-a51b-c405e5a4cb8c"],

