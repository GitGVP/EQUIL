Cell[BoxData[{
 RowBox[{
  RowBox[{"presentT", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"jacNew", ",", 
      RowBox[{
       RowBox[{"s_Symbol", "/;", 
        RowBox[{"StringMatchQ", "[", 
         RowBox[{
          RowBox[{"SymbolName", "[", "s", "]"}], ",", 
          RowBox[{"\"\<T\>\"", "~~", 
           RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], ":>", "s"}], ",", 
      "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"invRulesJac", "=", 
   RowBox[{"Association", "@", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"rule", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"lhs", "=", 
               RowBox[{"rule", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"rhs", "=", 
               RowBox[{"rule", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "tk", ",", "exp", ",", 
              "val"}], "}"}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "find", " ", "first", " ", "T", " ", "symbol", " ", "in", " ", 
               "RHS"}], ",", 
              RowBox[{"if", " ", "any"}]}], "*)"}], 
            RowBox[{
             RowBox[{"tk", "=", 
              RowBox[{"FirstCase", "[", 
               RowBox[{"rhs", ",", 
                RowBox[{
                 RowBox[{"s_Symbol", "/;", 
                  RowBox[{"isTSym", "[", "s", "]"}]}], ":>", "s"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"tk", "===", 
                 RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}]}], "||", 
                RowBox[{"!", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"presentT", ",", "tk"}], "]"}]}]}], ",", 
               RowBox[{"(*", 
                RowBox[{"skip", " ", "rules", " ", "that", " ", 
                 RowBox[{"don", "'"}], "t", " ", "define", " ", "a", " ", 
                 "present", " ", "T"}], "*)"}], "Nothing", ",", 
               RowBox[{"(*", 
                RowBox[{"compute", " ", "leading", " ", "exponent", " ", 
                 RowBox[{"(", "safe", ")"}], " ", "and", " ", "the", " ", 
                 "LO", " ", "coeff", " ", "of", " ", 
                 RowBox[{"lhs", "/", 
                  RowBox[{"\[Epsilon]", "^", "exp"}]}]}], "*)"}], 
               RowBox[{
                RowBox[{"exp", "=", 
                 RowBox[{"Quiet", "@", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Series", "[", 
                    RowBox[{"lhs", ",", 
                    RowBox[{"\[Epsilon]", "->", "0"}]}], "]"}], "[", 
                    RowBox[{"[", "4", "]"}], "]"}], ",", "0"}], "]"}]}]}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"val", "=", 
                 RowBox[{"Quiet", "@", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"LeafCount", "[", "lhs", "]"}], "<", "1000"}], 
                    ",", 
                    RowBox[{"Simplify", "[", 
                    RowBox[{"lhs", "/", 
                    RowBox[{"\[Epsilon]", "^", "exp"}]}], "]"}], ",", 
                    RowBox[{"lhs", "/", 
                    RowBox[{"\[Epsilon]", "^", "exp"}]}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "fallback", " ", "if", " ", "the", " ", "series", " ", 
                    "approach", " ", 
                    RowBox[{"failed", ":", 
                    RowBox[{
                    "simplify", " ", "the", " ", "lhs", " ", "directly"}]}]}],
                     "*)"}], 
                    RowBox[{"Simplify", "[", 
                    RowBox[{"Cancel", "[", "lhs", "]"}], "]"}]}], "]"}]}]}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"tk", "->", "val"}]}]}], "]"}]}]}], "]"}]}], "]"}], 
        ",", 
        RowBox[{"Normal", "[", "rulesJac", "]"}]}], "  ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "map", " ", "over", " ", "the", " ", "explicit", " ", "list", " ", 
          "of", " ", "rules"}], ";", 
         RowBox[{
         "rulesJac", " ", "is", " ", "assumed", " ", "to", " ", "be", " ", 
          "an", " ", "Association", " ", "or", " ", "list"}]}], "*)"}], "]"}],
       ",", "Nothing"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filteredRulesList", "=", 
   RowBox[{"Normal", "[", "invRulesJac", "]"}]}], ";"}], "\n", 
