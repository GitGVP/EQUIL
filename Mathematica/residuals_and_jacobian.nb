      RowBox[{
       RowBox[{"B", "[", 
        RowBox[{"r", ",", "mb"}], "]"}], 
       RowBox[{"Cos", "[", 
        RowBox[{"mb", " ", "\[Omega]"}], "]"}]}]}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
