                    RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"jj", ",", 
                    RowBox[{"Length", "[", "kdPairs", "]"}]}], "}"}]}], "]"}],
                   ";", "\[IndentingNewLine]", 
                  RowBox[{"posList", "=", 
                   RowBox[{"StringPosition", "[", 
                    RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
