                RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
