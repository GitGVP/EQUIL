      RowBox[{"(*", " ", 
       RowBox[{"Equation", " ", "of", " ", "state", " ", "part"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\tdBBdr = epsilon.*sum(Bsp.*cos(mb.*omega),3);\\n\>\""}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{
       "stream", ",", 
        "\"\<\\t[dbetapardB0, ...\n        dbetapardr, dbetapardB, \
dbetapardR, ...\n        d2betapardB2, d2betapardrdB, d2betapardRdB,~,~,...\n\
\\t\\t~, ~,~,~,~] = \
equation_of_state(kinetic_profiles,BB,dBBdr);\\n\\n\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Tn", " ", "definitions", " ", "from", " ", "invRules"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Tk", ",", "idx"}], "}"}], ",", 
          RowBox[{
           RowBox[{"Tk", "=", 
            RowBox[{
             RowBox[{"Keys", "[", "invRules", "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"presentTres", ",", "Tk"}], "]"}], ",", 
