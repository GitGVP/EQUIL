                  RowBox[{"Which", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"kkLocal", ",", "kkLocal"}], "}"}]}], "]"}], 
                    "==", "\"\<(\>\""}], ",", 
                    RowBox[{"dLocal", "++"}], ",", 
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"kkLocal", ",", "kkLocal"}], "}"}]}], "]"}], 
                    "==", "\"\<)\>\""}], ",", 
                    RowBox[{"dLocal", "--"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"kkLocal", ",", "kkLocal"}], "}"}]}], "]"}], 
                    "==", "\"\<,\>\""}], "&&", 
                    RowBox[{"dLocal", "==", "1"}]}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"commaPosList", ",", "kkLocal"}], "]"}], ",", 
                    "True", ",", "Null"}], "]"}], ";", "\[IndentingNewLine]", 
                  
                  RowBox[{"kkLocal", "++"}], ";"}]}], "]"}], ";"}]}], "]"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "commaPosList", "]"}], ">=", "1"}], ",", 
              RowBox[{
               RowBox[{"args", "=", 
                RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"prev", "=", 
                RowBox[{"p", "+", "4"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"j", "=", "1"}], ",", 
                 RowBox[{"j", "<=", 
                  RowBox[{"Length", "[", "commaPosList", "]"}]}], ",", 
                 RowBox[{"j", "++"}], ",", 
                 RowBox[{
                  RowBox[{"seg", "=", 
                   RowBox[{"StringTrim", "[", 
                    RowBox[{"StringTake", "[", 
                    RowBox[{"s2", ",", 
                    RowBox[{"{", 
                    RowBox[{"prev", ",", 
                    RowBox[{
                    RowBox[{"commaPosList", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", "1"}]}], "}"}]}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"args", ",", "seg"}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"prev", "=", 
                   RowBox[{
                    RowBox[{"commaPosList", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", "1"}]}], ";"}]}], 
                "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"seg", "=", 
                RowBox[{"StringTrim", "[", 
                 RowBox[{"StringTake", "[", 
                  RowBox[{"s2", ",", 
                   RowBox[{"{", 
                    RowBox[{"prev", ",", 
                    RowBox[{"idx", "-", "2"}]}], "}"}]}], "]"}], "]"}]}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"args", ",", "seg"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"inner", "=", 
                RowBox[{"args", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "detect", " ", "KroneckerDelta", " ", "selectors", " ", 
                 "inside", " ", "inner"}], "*)"}], 
               RowBox[{"kdPairs", "=", 
                RowBox[{"StringCases", "[", 
                 RowBox[{"inner", ",", 
                  RowBox[{
                   RowBox[{
                   "RegularExpression", "[", 
                    "\"\<KroneckerDelta\\\\s*\\\\(\\\\s*([^,]+)\\\\s*,\\\\s*([\
^\\\\)]+)\\\\s*\\\\)\>\"", "]"}], ":>", 
                   RowBox[{"{", 
                    RowBox[{"\"\<$1\>\"", ",", "\"\<$2\>\""}], "}"}]}]}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"kdPairs", "=!=", 
                  RowBox[{"{", "}"}]}], ",", 
                 RowBox[{
                  RowBox[{"Do", "[", 
                   RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"StringTrim", "[", 
                    RowBox[{"kdPairs", "[", 
                    RowBox[{"[", 
                    RowBox[{"jj", ",", "2"}], "]"}], "]"}], "]"}], "===", 
                    "var"}], ",", 
                    RowBox[{
                    RowBox[{"new", "=", 
                    RowBox[{"StringReplace", "[", 
                    RowBox[{"inner", ",", 
                    RowBox[{"var", "->", 
                    RowBox[{"StringTrim", "[", 
                    RowBox[{"kdPairs", "[", 
                    RowBox[{"[", 
                    RowBox[{"jj", ",", "1"}], "]"}], "]"}], "]"}]}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"jj", ",", 
                    RowBox[{"Length", "[", "kdPairs", "]"}]}], "}"}]}], "]"}],
                   ";", "\[IndentingNewLine]", 
                  RowBox[{"posList", "=", 
                   RowBox[{"StringPosition", "[", 
                    RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{"fallback", " ", "to", " ", "sum", 
                 RowBox[{"(", 
                  RowBox[{"...", ",", "3"}], ")"}], " ", "when", " ", 
                 "appropriate"}], "*)"}], 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "args", "]"}], ">=", "2"}], "&&", 
                  RowBox[{"StringMatchQ", "[", 
                   RowBox[{
                    RowBox[{"args", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{"RegularExpression", "[", 
                    RowBox[{
                    "\"\<\\\\s*\>\"", "<>", "var", "<>", "\"\<\\\\s*\>\""}], 
                    "]"}]}], "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"new", "=", 
                   RowBox[{
                   "\"\<sum(\>\"", "<>", "inner", "<>", "\"\<,3)\>\""}]}], 
                  ";", "\[IndentingNewLine]", 
                  RowBox[{"s2", "=", 
                   RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "args", "]"}], ">=", "2"}], "&&", 
                    RowBox[{"StringMatchQ", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "args", "]"}], ",", 
                    RowBox[{"RegularExpression", "[", 
                    RowBox[{
                    "\"\<\\\\s*\>\"", "<>", "var", "<>", "\"\<\\\\s*\>\""}], 
                    "]"}]}], "]"}]}], ",", 
                   RowBox[{
                    RowBox[{"inner", "=", 
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"Riffle", "[", 
                    RowBox[{
                    RowBox[{"Most", "[", "args", "]"}], ",", "\"\<,\>\""}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"new", "=", 
                    RowBox[{
                    "\"\<sum(\>\"", "<>", "inner", "<>", "\"\<,3)\>\""}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"s2", "=", 
                    RowBox[{"StringReplacePart", "[", 
                    RowBox[{"s2", ",", "new", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
                   RowBox[{
                    RowBox[{"posList", "=", 
                    RowBox[{"Delete", "[", 
                    RowBox[{"posList", ",", 
                    RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Continue", "[", "]"}]}]}], "]"}]}], "]"}], ";"}],
               ",", 
              RowBox[{
               RowBox[{"posList", "=", 
                RowBox[{"Delete", "[", 
                 RowBox[{"posList", ",", 
                  RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"posList", "=", 
             RowBox[{"StringPosition", "[", 
              RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";"}]}], "]"}], 
         ";", "\[IndentingNewLine]", "s2"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"end", " ", "replaceSum"}], "*)"}], 
     RowBox[{"str", "=", 
      RowBox[{"replaceSum", "[", 
       RowBox[{"str", ",", "\"\<ms\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"replaceSum", "[", 
       RowBox[{"str", ",", "\"\<mb\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"replaceSum", "[", 
       RowBox[{"str", ",", "\"\<m\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"str", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<S(ms)\>\"", "->", "\"\<S\>\""}], ",", 
          RowBox[{"\"\<Sp(ms)\>\"", "->", "\"\<Sp\>\""}], ",", 
          RowBox[{"\"\<Spp(ms)\>\"", "->", "\"\<Spp\>\""}], ",", 
          RowBox[{"\"\<Bs(mb)\>\"", "->", "\"\<Bs\>\""}], ",", 
          RowBox[{"\"\<Bsp(mb)\>\"", "->", "\"\<Bsp\>\""}], ",", 
          RowBox[{"\"\<Bspp(mb)\>\"", "->", "\"\<Bspp\>\""}], ",", 
          RowBox[{"\"\<KroneckerDelta(kp,kp)\>\"", "->", "\"\<1\>\""}]}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"StringTrim", "[", "str", "]"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WriteRes", "[", 
     RowBox[{"fileName_String", ",", "funcName_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"stream", ",", "argsStr", ",", "nRes"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"argsStr", "=", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\"\<r\>\"", ",", "\"\<x\>\"", ",", "\"\<epsilon\>\"", ",", 
            "\"\<omega\>\"", ",", "\"\<kinetic_profiles\>\"", ",", 
            "\"\<q\>\"", ",", "\"\<qp\>\"", ",", "\"\<P0\>\"", ",", 
            "\"\<P1\>\"", ",", "\"\<P2\>\"", ",", "\"\<M_profiles\>\"", ",", 
            "\"\<dof_count\>\"", ",", " ", "\"\<Nb\>\"", ",", " ", 
            "\"\<Sbc\>\"", ",", "\"\<equation_of_state\>\""}], "}"}], ",", 
          "\"\<,\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"stream", "=", 
        RowBox[{"OpenWrite", "[", "fileName", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "HEADER", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", 
         RowBox[{
         "\"\<function R = \>\"", "<>", "funcName", "<>", "\"\<(\>\"", "<>", 
          "argsStr", "<>", "\"\<)\\n\>\""}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tN = numel(r);\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tNs = numel(Sbc);\\n\>\""}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tnRes = 3+Nb+Ns;\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Unknowns", " ", "unpacking"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tt2_c    = x(1:dof_count);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tdelta_c = x(dof_count+1:2*dof_count);\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", "\"\<\\tP_c = x(2*dof_count+1:3*dof_count);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tBs_c    = reshape(x(3*dof_count+1:(3+Nb)*dof_count), \
[dof_count, 1, Nb]);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tBs_flat   = reshape(Bs_c, size(Bs_c,1), []);        % \
dof_count x Ns\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tS_unkn     = reshape(x((3+Nb)*dof_count+1:end), \
[dof_count-1, 1, Ns]);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tS_c     = cat(1, S_unkn, reshape(Sbc, [1, 1, \
Ns]));\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tS_flat   = reshape(S_c, size(S_c,1), []);        % dof_count \
x Ns\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Reconstruction", " ", "at", " ", "quadrature", " ", "points"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tt2      = P0 * t2_c;\\n\>\""}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tt2p     = P1 * t2_c;\\n\>\""}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tdelta   = P0 * delta_c;\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tdeltap  = P1 * delta_c;\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tdeltapp = P2 * delta_c;\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tP   = P0 * P_c;\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tPp  = P1 * P_c;\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tPpp = P2 * P_c;\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tBs       = reshape(P0 * Bs_flat, N, 1, []);\\n\\tBsp = \
reshape(P1 * Bs_flat, N, 1, []);\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tS       = reshape(P0 * S_flat, N, 1, []);\\n\\tSp = \
reshape(P1 * S_flat, N, 1, []);\\n\\tSpp = reshape(P2 * S_flat, N, 1, []);\\n\
\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tresTotal = zeros(nRes,N);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tms = reshape(linspace(2,Ns+1,Ns), [1,1,Ns]);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", "\"\<\\tmb = reshape(0:(Nb-1), [1,1,Nb]);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "Residuals", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", 
         RowBox[{"\"\<\\tresF = \>\"", "<>", 
          RowBox[{"ToMatlab", "[", "resF", "]"}], "<>", "\"\<;\\n\>\""}]}], 
        "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", 
         RowBox[{"\"\<\\tresB = \>\"", "<>", 
          RowBox[{"ToMatlab", "[", "resBB", "]"}], "<>", "\"\<;\\n\>\""}]}], 
        "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tresF_FFT = real(fft(resF, [], 2))/numel(omega);\\n\>\""}], 
        "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tresB_FFT = real(fft(resB, [], 2))/numel(omega);\\n\>\""}], 
        "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tmF = [0, 1, 2:(Ns+1)];\\n\>\""}], 
        "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\trowsF = [1, 2, (2 + Nb + (2:(Ns+1)))];\\n\>\""}], "]"}], ";",
        "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\tmB = 0:(Nb-1);\\n\>\""}], "]"}], ";", 
       "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<\\trowsB = 3 + (1:Nb);\\n\>\""}], "]"}], 
       ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tresTotal(rowsF, :) = resF_FFT(:, mF + 1).';\\n\>\""}], "]"}],
        ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tresTotal(rowsB, :) = resB_FFT(:, mB + 1).';\\n\>\""}], "]"}],
        ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", 
         RowBox[{"\"\<\\tresTotal(3,:) = mean(\>\"", "<>", 
          RowBox[{"ToMatlab", "[", "resP", "]"}], "<>", 
          "\"\<, 2);\\n\>\""}]}], "]"}], ";", "\n", 
       RowBox[{"WriteString", "[", 
        RowBox[{
        "stream", ",", 
         "\"\<\\tR = M_profiles * reshape(resTotal.', [], 1);\\n\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", "\"\<end\\n\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Close", "[", "stream", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Wrote MATLAB file \[OpenCurlyDoubleQuote]\>\"", ",", "fileName", 
         ",", "\"\<\[CloseCurlyDoubleQuote] with <\>\"", ",", "funcName", 
         ",", "\"\<>.\>\""}], "]"}], ";"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WriteJac", "[", 
