                   RowBox[{"ToString", "[", "d", "]"}], "<>", 
                   RowBox[{"ToString", "[", "j", "]"}], "<>", 
                   "\"\<F, [], 2)) / Ntheta;\\n\>\""}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"WriteString", "[", 
