Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ToMatlab", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "str", ",", "replaceSum", ",", "posList", ",", "p", ",", "slen", ",", 
       "idx", ",", "commaPosList", ",", "args", ",", "inner", ",", "new", ",",
        "kdPairs", ",", "kk", ",", "depth", ",", "prev", ",", "j", ",", 
       "seg"}], "}"}], ",", 
     RowBox[{
      RowBox[{"str", "=", 
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"expr", "/.", " ", "numrepl"}], ",", "FortranForm"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<\\n\>\"", "->", "\"\< \>\""}], ",", 
           RowBox[{"\"\<\\r\>\"", "->", "\"\< \>\""}], ",", 
           RowBox[{"\"\<\\t\>\"", "->", "\"\< \>\""}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringTrim", "[", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"str", ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<\\\\s+\>\"", "]"}], "->", 
           "\"\< \>\""}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Cos\>\"", "->", "\"\<cos\>\""}], ",", 
           RowBox[{"\"\<Sin\>\"", "->", "\"\<sin\>\""}], ",", 
           RowBox[{"\"\<Csc\>\"", "->", "\"\<csc\>\""}], ",", 
           RowBox[{"\"\<**\>\"", "->", "\"\<.^\>\""}], ",", 
           RowBox[{"\"\<*\>\"", "->", "\"\<.*\>\""}], ",", 
           RowBox[{"\"\</\>\"", "->", "\"\<./\>\""}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"replaceSum", "[", 
        RowBox[{"s_String", ",", "var_String"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s2", "=", "s"}], "}"}], ",", 
         RowBox[{
          RowBox[{"posList", "=", 
           RowBox[{"StringPosition", "[", 
            RowBox[{"s2", ",", "\"\<Sum(\>\""}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{"posList", "=!=", 
