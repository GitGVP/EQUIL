         RowBox[{"r", "  ", 
          RowBox[{
           SuperscriptBox["betapar", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"1", ",", "1", ",", "0"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"r", ",", "1", ",", "1"}], "]"}]}]}], ")"}]}]}], ")"}], 
    "+", " ", 
    RowBox[{
     RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
     RowBox[{"Cos", "[", "\[Omega]", "]"}]}], " ", "+", " ", 
    RowBox[{
