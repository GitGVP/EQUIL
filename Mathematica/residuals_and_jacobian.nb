                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"idx", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
