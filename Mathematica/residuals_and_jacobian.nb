Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"leadingExp", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"eps_", ":", "\[Epsilon]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", "=", 
       RowBox[{"Series", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"eps", "->", "0"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "s", "]"}], "===", "SeriesData"}], ",", 
       RowBox[{"s", "[", 
        RowBox[{"[", "4", "]"}], "]"}], ",", "0"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"isTSym", "[", "s_Symbol", "]"}], ":=", 
   RowBox[{"StringMatchQ", "[", 
    RowBox[{
     RowBox[{"SymbolName", "[", "s", "]"}], ",", 
     RowBox[{"\"\<T\>\"", "~~", 
      RowBox[{"DigitCharacter", ".."}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"invRules", "=", 
   RowBox[{"Association", "@", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"rule", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"lhs", "=", 
               RowBox[{"rule", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"rhs", "=", 
               RowBox[{"rule", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "tk", ",", "exp"}], 
             "}"}], ",", 
            RowBox[{
             RowBox[{"tk", "=", 
              RowBox[{"FirstCase", "[", 
               RowBox[{"rhs", ",", 
                RowBox[{"_Symbol", "?", "isTSym"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"tk", "===", 
                RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}]}], ",", 
               "Nothing", ",", 
               RowBox[{
                RowBox[{"exp", "=", 
                 RowBox[{"leadingExp", "[", 
                  RowBox[{"lhs", ",", "\[Epsilon]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"tk", "->", 
                 RowBox[{"(", 
                  RowBox[{"Simplify", "@", 
                   RowBox[{"Cancel", "[", 
                    RowBox[{"lhs", "/", 
                    RowBox[{"\[Epsilon]", "^", "exp"}]}], "]"}]}], 
                  ")"}]}]}]}], "]"}]}]}], "]"}]}], "]"}], ",", 
        RowBox[{"Normal", "[", "rules", "]"}]}], "]"}], ",", "Nothing"}], 
     "]"}]}]}], ";"}]}], "Input",
